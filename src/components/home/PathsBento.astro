---
/**
 * PathsBento.astro — « choisissez votre instrument », le point de conversion
 * de la page d'accueil. Quatre parcours, chacun avec sa couleur, sa promesse
 * (celle de la fiche cours), pour qui c'est fait, et les trois chiffres qui
 * comptent : leçons, durée, prix.
 *
 * Variantes : 'bento' (mosaïque asymétrique), 'row' (quatre colonnes égales),
 * 'stack' (liste horizontale, image à gauche, pour une page en une colonne).
 */
import { paths } from '../../data/home-v2';

interface Props {
  variant?: 'bento' | 'row' | 'stack';
  heading?: string;
  intro?: string;
  id?: string;
}

const {
  variant = 'bento',
  heading = 'Par quel instrument commencer ?',
  intro = 'Chaque parcours part de zéro et va jusqu’aux premiers morceaux. Un seul paiement, l’accès reste ouvert.',
  id = 'parcours',
} = Astro.props;
---

<section class={`paths paths--${variant}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="paths__head">
      <h2 id={`${id}-title`}>{heading}</h2>
      <p>{intro}</p>
    </header>

    <ul class="paths__grid" role="list">
      {paths.map((p) => (
        <li class={`path path--${p.id} theme-${p.id}`}>
          <a href={p.url} class="path__link">
            <div class="path__media">
              <img src={p.image} alt={p.imageAlt} width="768" height="512" loading="lazy" decoding="async" />
            </div>
            <div class="path__body">
              <p class="path__kicker">{p.label}</p>
              <h3 class="path__title">{p.tagline}</h3>
              <p class="path__audience">{p.audience}</p>
              <p class="path__win">{p.firstWin}</p>
              <dl class="path__meta">
                <div><dt>Leçons</dt><dd>{p.lessons}</dd></div>
                <div><dt>Durée</dt><dd>{p.duration}</dd></div>
                <div><dt>Prix</dt><dd>{p.price}</dd></div>
              </dl>
              <span class="path__cta">Voir les cours de {p.label.toLowerCase()}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="paths__help">
      Vous hésitez entre deux ? <a href="/quel-instrument-choisir/">Un test de deux minutes vous oriente</a>.
    </p>
  </div>
</section>

<style>
  .paths {
    padding: var(--space-20) 0;
  }

  .paths__head {
    max-width: 640px;
    margin-bottom: var(--space-10);
  }

  .paths__head h2 {
    font-size: var(--text-responsive-3xl);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    margin-bottom: var(--space-3);
  }

  .paths__head p {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .paths__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .path {
    border-radius: var(--radius-xl);
    background: var(--bg-card);
    border: 1px solid var(--theme-line);
    overflow: hidden;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out);
  }

  .path:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .path__link {
    display: grid;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .path__link:focus-visible {
    outline: 3px solid var(--theme-current);
    outline-offset: -3px;
    border-radius: var(--radius-xl);
  }

  .path__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--theme-soft);
  }

  .path__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .path__body {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .path__kicker {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--theme-ink);
  }

  .path__title {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .path__audience {
    margin: 0;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .path__win {
    margin: var(--space-1) 0 0;
    font-weight: var(--font-medium);
    color: var(--text-primary);
  }

  .path__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin: var(--space-3) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-default);
  }

  .path__meta div {
    display: grid;
  }

  .path__meta dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--text-muted);
  }

  .path__meta dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .path__cta {
    margin-top: var(--space-3);
    font-weight: var(--font-semibold);
    color: var(--theme-ink);
  }

  .path__cta::after {
    content: ' →';
  }

  .paths__help {
    margin: var(--space-8) 0 0;
    color: var(--text-secondary);
  }

  .paths__help a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- bento : mosaïque asymétrique sur grand écran ---- */
  @media (min-width: 900px) {
    .paths--bento .paths__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: auto;
    }

    .paths--bento .path--guitar { grid-column: span 7; }
    .paths--bento .path--piano { grid-column: span 5; }
    .paths--bento .path--ukulele { grid-column: span 5; }
    .paths--bento .path--solfege { grid-column: span 7; }

    .paths--bento .path--guitar .path__link,
    .paths--bento .path--solfege .path__link {
      grid-template-columns: 1fr 1fr;
    }

    .paths--bento .path--guitar .path__media,
    .paths--bento .path--solfege .path__media {
      aspect-ratio: auto;
      height: 100%;
    }

    .paths--bento .path--guitar .path__title {
      font-size: var(--text-3xl);
    }
  }

  /* ---- row : quatre colonnes ---- */
  @media (min-width: 900px) {
    .paths--row .paths__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---- stack : image à gauche, texte à droite ---- */
  @media (min-width: 640px) {
    .paths--stack .path__link {
      grid-template-columns: 220px 1fr;
    }

    .paths--stack .path__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .path {
      transition: none;
    }

    .path:hover {
      transform: none;
    }
  }
</style>
