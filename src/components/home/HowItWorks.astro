---
/**
 * HowItWorks.astro — « comment ça se passe », en trois temps.
 * Répond à la question que se pose l'adulte débutant : par quoi je commence,
 * combien de temps ça me prend, quand est-ce que je joue quelque chose.
 */
import { steps } from '../../data/home-v2';

interface Props {
  heading?: string;
  /** 'columns' : trois colonnes ; 'ladder' : liste verticale numérotée en grand. */
  variant?: 'columns' | 'ladder';
}

const { heading = 'Comment ça se passe, concrètement ?', variant = 'columns' } = Astro.props;
---

<section class={`how how--${variant}`} aria-labelledby="how-title">
  <div class="container">
    <h2 id="how-title">{heading}</h2>
    <ol class="how__list">
      {steps.map((step) => (
        <li class="how__step">
          <span class="how__num" aria-hidden="true">{step.number}</span>
          <div class="how__body">
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            {step.link && <a href={step.link.url} class="how__link">{step.link.label}</a>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how {
    padding: var(--space-20) 0;
  }

  .how h2 {
    font-size: var(--text-responsive-3xl);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    max-width: 20ch;
    margin-bottom: var(--space-10);
  }

  .how__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .how__step {
    display: grid;
    gap: var(--space-3);
  }

  .how__num {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: var(--font-bold);
    line-height: 1;
    color: var(--home-accent, var(--brand-500));
    font-variant-numeric: tabular-nums;
  }

  .how__body h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
    text-wrap: balance;
  }

  .how__body p {
    margin: 0;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    text-wrap: pretty;
  }

  .how__link {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--text-primary);
    font-weight: var(--font-medium);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .how--columns .how__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-10);
    }

    .how--ladder .how__step {
      grid-template-columns: 120px 1fr;
      gap: var(--space-8);
      padding: var(--space-8) 0;
      border-top: 1px solid var(--border-default);
    }

    .how--ladder .how__num {
      font-size: var(--text-6xl);
    }
  }
</style>
