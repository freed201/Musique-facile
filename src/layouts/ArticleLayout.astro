---
import Header from '../components/Header.astro';
import ConsentManager from '../components/ConsentManager.astro';
import FooterModern from '../components/FooterModern.astro';
import ExternalResources from '../components/ExternalResources.astro';
import AutoFAQ from '../components/AutoFAQ.astro';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/raleway/400.css'; // utilisée par article.css
import '../styles/global.css';
import '../styles/article.css';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  author: string;
  datePublished: string;
  dateModified: string;
  url: string;
  theme?: 'guitar' | 'piano' | 'ukulele' | 'solfege';
  videos?: Array<{ url: string; title?: string; description?: string; duration?: string; thumbnail?: string }>;
  songInfo?: {
    inBook?: boolean;
    bookPage?: number;
    tempo?: number | string;
    chordCount?: number;
    difficulty?: string;
    key?: string;
    artist?: string;
    composers?: string[];
    year?: number;
  };
  showAutoFaq?: boolean;
}

import videoMetadata from '../data/video-metadata.json';

const { title, description, ogImage, author, datePublished, dateModified, url, theme = 'main', videos, songInfo, showAutoFaq = true } = Astro.props;
const siteUrl = 'https://musique-facile.fr';
const ogImageValue = ogImage || '/images/og-default.webp';
const absoluteOgImage = ogImageValue.startsWith('http') ? ogImageValue : `${siteUrl}${ogImageValue}`;

// Title et meta description : ceux du frontmatter, tels quels.
//
// Ils étaient « enrichis » par songInfo : « … | 5 Accords | Difficulté 3/5 »
// en fin de title (78-90 caractères, deux barres verticales, coupé par Google
// vers 60), et « Tutoriel complet : 5 accords, niveau 3/5… » devant la
// description, tronquée ensuite par « ... ». Les descriptions sont rédigées à
// la main au bon gabarit (#71) : on les sert sans retouche. Décision du
// 2026-11-05, point 5 de docs/seo/A-FAIRE.md.
const pageTitle = title;
const pageDescription = description;

// Note : le fil d'Ariane (visuel + Schema BreadcrumbList) est rendu par
// BreadcrumbsSchema dans blog/[slug].astro avec une hiérarchie plus riche.
// On ne le duplique donc plus ici (évite un double BreadcrumbList JSON-LD).

// Formatage des dates pour schema.org
const isoDatePublished = new Date(datePublished).toISOString();
const isoDateModified = new Date(dateModified).toISOString();

// Schema Person enrichi pour l'auteur Fred Fieffé
const authorSchema = {
  "@type": "Person",
  "name": "Fred Fieffé",
  "url": "https://musique-facile.fr/auteur/fred-fieffe/",
  "jobTitle": "Musicien professionnel et formateur",
  "description": "Auteur publié chez Hal Leonard, plus de 80 000 élèves formés en ligne, auteur du spectacle « La Légende des 4 Terres » primé au Prix spécial Samuel Paty des DDEN 2024.",
  "sameAs": [
    "https://www.youtube.com/@Musique-Facile",
    "https://www.tiktok.com/@musique_facile",
    "https://www.linkedin.com/in/fr%C3%A9d%C3%A9ric-fieff%C3%A9/",
    "https://musique-facile.fr"
  ],
  "knowsAbout": ["guitare", "piano", "ukulélé", "solfège", "pédagogie musicale"],
  // E-E-A-T : les crédentiels rendent l'auteur identifiable et vérifiable, ce
  // que les moteurs IA privilégient pour citer une source. Doit rester aligné
  // sur /auteur/fred-fieffe/ et sur .claude/rules/contenu-credibilite.md.
  "award": [
    "Prix spécial Samuel Paty des DDEN 2024 (spectacle « La Légende des 4 Terres »)",
    "Meilleur formateur Skilleos 2023/2024"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Expérience professionnelle",
      "name": "Musicien professionnel depuis plus de 40 ans"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Expérience professionnelle",
      "name": "15 ans d'enseignement de la musique, plus de 80 000 élèves formés"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Publication",
      "name": "Auteur publié chez Hal Leonard"
    },
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Formation professionnelle",
      "name": "Formateur LinkedIn Learning"
    }
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Musique Facile",
    "url": "https://musique-facile.fr"
  }
};

// Le morceau enseigné, en MusicComposition. Seulement à partir des champs
// songInfo renseignés (vérifiés), qui sont aussi affichés dans l'encart de
// la page : le balisage ne dit rien que le lecteur ne voie pas.
const songName = title.split(/\s+\(|\s+:/)[0].trim();
// « Traditionnel » n'est pas une personne : pas de `composer` dans ce cas.
const composers = (songInfo?.composers ?? []).filter((name) => name !== 'Traditionnel');
const songSchema = songInfo && (songInfo.artist || composers.length) ? {
  "@type": "MusicComposition",
  "name": songName,
  ...(composers.length
    ? { "composer": composers.map((name) => ({ "@type": "Person", "name": name })) }
    : {}),
  ...(songInfo.key ? { "musicalKey": songInfo.key } : {}),
  ...(songInfo.artist ? {
    "recordedAs": {
      "@type": "MusicRecording",
      "name": songName,
      "byArtist": { "@type": "MusicGroup", "name": songInfo.artist },
      ...(songInfo.year ? { "datePublished": String(songInfo.year) } : {})
    }
  } : {})
} : null;

// Le livre « 40 chansons », dont ces articles sont les pages compagnons.
// Référencé par l'URL de sa fiche, qui porte le schema Book complet.
const BOOK_REF = {
  "@type": "Book",
  "name": "40 Chansons Françaises et Hits Pop-Rock",
  "url": "https://musique-facile.fr/livres/40-chansons-francaises-et-hits-pop-rock/",
  "author": { "@type": "Person", "name": "Fred Fieffé" }
};

// Construction du schema.org BlogPosting
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": pageTitle,
  "description": pageDescription,
  "image": absoluteOgImage,
  "author": authorSchema,
  "publisher": {
    "@type": "Organization",
    "name": "Musique Facile",
    "logo": {
      "@type": "ImageObject",
      "url": "https://musique-facile.fr/logo.webp"
    }
  },
  "datePublished": isoDatePublished,
  "dateModified": isoDateModified,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".article-intro", ".faq-section"]
  },
  ...(songSchema ? { "about": songSchema } : {}),
  ...(songInfo?.inBook ? { "mentions": BOOK_REF } : {})
};

// Helper pour extraire ID YouTube
const extractYouTubeId = (url: string) => {
  if (url.includes('/shorts/')) {
    return url.split('/shorts/')[1].split('?')[0];
  }
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
};

// Construction du schema VideoObject.
//
// `uploadDate` valait auparavant `isoDatePublished`, c'est-à-dire la date de
// publication de l'ARTICLE : une date de mise en ligne inventée, et aucune
// durée déclarée. Les deux sont désormais lues dans src/data/video-metadata.json,
// relevé sur les pages YouTube (`npm run videos:metadata`).
//
// Une vidéo absente du relevé, ou devenue indisponible, ne produit plus de
// VideoObject : mieux vaut pas de balisage qu'un balisage pointant vers une
// vidéo morte.
const videoSchemas = videos && videos.length > 0 ? videos.flatMap(video => {
  const videoId = extractYouTubeId(video.url);
  const meta = videoId ? (videoMetadata.videos as Record<string, any>)[videoId] : null;
  if (!videoId || meta?.status !== 'ok') return [];
  return [{
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": video.title || meta.youtubeTitle || pageTitle,
    "description": video.description || pageDescription,
    "thumbnailUrl": meta.thumbnail ? `https://musique-facile.fr${meta.thumbnail}` : absoluteOgImage,
    "uploadDate": meta.uploadDate,
    ...(meta.duration ? { "duration": meta.duration } : {}),
    "contentUrl": `https://www.youtube.com/watch?v=${videoId}`,
    "embedUrl": `https://www.youtube-nocookie.com/embed/${videoId}`,
    "publisher": {
      "@type": "Organization",
      "name": "Musique Facile",
      "logo": {
        "@type": "ImageObject",
        "url": "https://musique-facile.fr/logo.webp"
      }
    }
  }];
}) : [];

// Le schema HowTo est supprimé (2026-11-05). Ses valeurs étaient inventées :
// une durée calculée en divisant 300 par le tempo (258 minutes pour
// Hallelujah), un coût de 0 €, et quatre étapes génériques identiques sur
// chaque page. Google n'affiche plus de résultat enrichi HowTo depuis 2023.
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Consentement cookies + GTM (chargé après consentement) -->
    <ConsentManager />
    
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog Musique Facile"
      href="https://musique-facile.fr/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="article:published_time" content={isoDatePublished} />
    <meta property="article:modified_time" content={isoDateModified} />
    <meta property="article:author" content={author} />

    <!-- GEO: Citation metadata pour moteurs IA -->
    <meta name="citation_title" content={pageTitle} />
    <meta name="citation_author" content="Fred Fieffé" />
    <meta name="citation_date" content={isoDatePublished.split('T')[0]} />
    <meta name="citation_publisher" content="Musique Facile" />
    <meta name="citation_public_url" content={url} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Schema.org BlogPosting -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Schema.org VideoObject (si vidéos présentes) -->
    {videoSchemas.length > 0 && videoSchemas.map(videoSchema => (
      <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
    ))}

    <ExternalResources loadVideoScripts={Boolean(videos && videos.length > 0)} />
    <title>{pageTitle}</title>
  </head>
  <body>
   <div class={`theme-${theme}`}>
    <Header />
    <main>
      <slot />
    </main>
    {showAutoFaq && (
      <AutoFAQ title={title} theme={theme} songInfo={songInfo} showVisual={true} />
    )}
    <FooterModern />
   </div>
  </body>
</html>

<style is:global>
  /* Garder tous les styles précédents jusqu'à article-conclusion */

  .article-conclusion {
    position: relative;
    padding: 6rem 0;
    background: linear-gradient(135deg, var(--color-dark) 0%, #2a2a2a 100%);
    color: white;
    margin: 6rem 0;
    border-radius: var(--border-radius);
    overflow: hidden;
  }

  .article-conclusion::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, 
      var(--theme-current) 0%,
      var(--theme-current-light) 100%
    );
  }

  .article-conclusion::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.1;
    z-index: 0;
  }

  .conclusion-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .conclusion-content::before {
    content: '"';
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 6rem;
    font-family: Georgia, serif;
    color: var(--theme-current);
    opacity: 0.3;
    line-height: 1;
  }

  .conclusion-content h2 {
    color: var(--theme-current);
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
    position: relative;
    padding-bottom: 1rem;
  }

  .conclusion-content h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 3px;
    background: var(--theme-current);
    border-radius: 2px;
  }

  .conclusion-content p {
    font-size: 1.2rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .conclusion-content p:last-child {
    margin-bottom: 0;
  }

  /* Garder tous les styles suivants (related-links, etc.) */

  .related-links {
    margin: 4rem auto;
    max-width: 800px;
    padding: 0 1.5rem;
  }

  .related-links h2 {
    margin-bottom: 2rem;
    color: var(--color-dark);
  }

  .related-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .related-link {
    padding: 1.5rem;
    background: white;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    text-decoration: none;
    color: var(--color-dark);
    transition: all 0.3s ease;
  }

  .related-link:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 2.5rem;
    }

    .article-meta {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .conclusion-content {
      padding: 2rem;
      margin: 0 1rem;
    }

    .conclusion-content h2 {
      font-size: 2rem;
    }

    .conclusion-content::before {
      font-size: 4rem;
      top: -20px;
    }
  }

  /* Styles spécifiques aux articles de blog */
  .article-hero {
    min-height: 60vh;
    position: relative;
    display: flex;
    align-items: center;
    padding: 8rem 0 4rem;
    background-color: var(--color-dark);
    color: white;
    overflow: hidden;
  }

  .article-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    z-index: 0;
  }

  .article-hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
    background: rgba(0, 0, 0, 0.7);
    border-radius: var(--border-radius);
    padding: 2rem;
    backdrop-filter: blur(10px);
  }

  .article-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .article-title {
    font-size: 3.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    color: white;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .article-description {
    font-size: 1.2rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Bandeau compact des 40 tutos du livre : le lecteur arrive par QR code,
     sur mobile, pour les vidéos placées juste dessous. Le bandeau standard
     (60vh minimum) les repoussait à deux écrans de défilement. */
  .article-hero--compact {
    min-height: 0;
    padding: 7rem 0 2rem;
  }

  @media (max-width: 768px) {
    .article-hero--compact {
      padding: 1rem 0;
    }
    .article-hero--compact .article-hero-content {
      padding: 1.25rem;
    }
    .article-hero--compact .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      margin-bottom: 0.75rem;
    }
    .article-hero--compact .article-title {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
    }
    .article-hero--compact .article-description {
      font-size: 1rem;
    }
  }

  .article-content {
    margin: 4rem auto;
    padding: 0 1.5rem;
  }

  /* Sans TOC, largeur normale */
  .article-content:not(.with-toc) {
    max-width: 800px;
  }

  .article-intro {
    font-size: 1.2rem;
    line-height: 1.8;
    margin-bottom: 3rem;
    color: var(--color-dark);
  }

  /* La section n'est rendue que si l'article déclare des vidéos
     (src/pages/blog/[slug].astro) : aucune condition CSS à ajouter ici.
     Un ancien `display: none` + `:has(.video-item)` a masqué toutes les
     vidéos du blog quand VideoEmbed a remplacé les .video-item (#59). */
  /* Fond toujours sombre : --gray-* ne s'inversent pas en mode sombre,
     contrairement à --color-dark qui y devient clair. */
  .video-section {
    padding: 4rem 0;
    background: linear-gradient(135deg, var(--gray-900) 0%, var(--gray-800) 100%);
    color: white;
    margin: 4rem 0;
  }

  /* La légende de VideoEmbed est pensée pour un fond clair (--text-secondary) :
     illisible ici sans cette surcharge. */
  .video-section .video-grid .video-embed__caption {
    color: var(--gray-300);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .podcast-section {
    display: none; /* Caché par défaut */
    padding: 4rem 0;
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    margin: 4rem 0;
  }

  /* Afficher la section podcast uniquement si elle contient un podcast */
  .podcast-section:has(iframe) {
    display: block;
  }

  .podcast-player {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    background: white;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }
</style>
