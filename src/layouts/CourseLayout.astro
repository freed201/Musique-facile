---
import Header from '../components/Header.astro';
import ConsentManager from '../components/ConsentManager.astro';
import FooterModern from '../components/FooterModern.astro';
import ExternalResources from '../components/ExternalResources.astro';
import JsonLD from '../components/JsonLD.astro';
// Poppins porte les titres et les libellés d'interface : sans le 600, le
// navigateur fabriquait un faux gras à partir du 400. Inter porte le texte
// courant — elle était déclarée dans --font-body sans être chargée.
// Raleway ne sert qu'aux articles : ne pas la charger ici.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  theme?: 'guitar' | 'piano' | 'ukulele' | 'solfege';
  hero?: {
    stats?: Array<{ value: string; label: string; icon: string }>;
  };
  teachers?: {
    mainTeachers?: Array<{ firstName: string; lastName: string }>;
  };
  ratingValue?: string;
  reviewCount?: string;
  /** Programme de la formation → Course.syllabusSections */
  syllabusSections?: Array<Record<string, unknown>>;
  /** Durée ISO 8601 déjà normalisée par la page (« PT2H40M ») */
  isoDuration?: string;
}


const { title, description, ogImage, theme = 'guitar', hero, teachers, ratingValue, reviewCount, syllabusSections, isoDuration } = Astro.props;
const siteUrl = 'https://musique-facile.fr';
const ogImageValue = ogImage || '/images/og-default.jpg';
const absoluteOgImage = ogImageValue.startsWith('http') ? ogImageValue : `${siteUrl}${ogImageValue}`;

// Enrichissement automatique du titre pour le SEO (max 60 caractères)
const enrichTitle = () => {
  const MAX_TITLE_LENGTH = 60;

  // Base : titre + marque
  let baseTitle = `${title} | Musique Facile`;

  // Si le titre de base est déjà trop long, on utilise le titre seul sans la marque
  if (baseTitle.length > MAX_TITLE_LENGTH) {
    return title.length <= MAX_TITLE_LENGTH ? title : title.substring(0, MAX_TITLE_LENGTH);
  }

  return baseTitle;
};

const pageTitle = enrichTitle();

// Enrichissement de la meta description
const enrichDescription = () => {
  const chaptersCount = hero?.stats?.find(s => s.label.includes('chapitre'))?.value;
  const studentsCount = hero?.stats?.find(s => s.label.includes('élèves'))?.value;
  const teacher = teachers?.mainTeachers?.[0];
  const teacherName = teacher ? `${teacher.firstName} ${teacher.lastName}` : 'notre formateur expert';

  let enriched = description;

  // Ajouter des stats concrètes si la description est générique
  if (chaptersCount && studentsCount) {
    enriched = `Apprenez avec ${teacherName} : ${chaptersCount} chapitres progressifs. ${studentsCount} élèves formés. ${description}`;
  }

  // Limiter à 155 caractères pour Google
  if (enriched.length > 155) {
    enriched = enriched.substring(0, 152) + '...';
  }

  return enriched;
};

const pageDescription = enrichDescription();


// Construction du schema.org enrichi
const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": title,
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "Musique Facile",
    "url": "https://musique-facile.fr",
    "logo": {
      "@type": "ImageObject",
      "url": "https://musique-facile.fr/logo.webp"
    },
    "sameAs": [
      "https://www.youtube.com/@Musique-Facile",
      "https://www.tiktok.com/@musique_facile",
      "https://www.instagram.com/guitare_et_ukulele_facile/?hl=fr"
    ]
  },
  "instructor": {
    "@type": "Person",
    "name": "Fred Fieffé",
    "jobTitle": "Professeur de Musique",
    "description": "Musicien professionnel avec 40 ans de pratique et 15 ans d'enseignement. Formateur sur LinkedIn Learning, Skilleos et auteur chez Hal Leonard.",
    "url": "https://musique-facile.fr/a-propos/",
    "sameAs": [
      "https://www.youtube.com/@Musique-Facile",
      "https://www.linkedin.com/learning/instructors/fred-fieffe",
      "https://www.tiktok.com/@musique_facile"
    ]
  },
  "image": absoluteOgImage,
  "url": Astro.url.toString(),
  "inLanguage": "fr-FR",
  // Durée normalisée par la page. Le fallback précédent, « P20H », était un
  // ISO 8601 invalide (il manque le T) et donc ignoré.
  "timeRequired": isoDuration || "PT2H",
  ...(syllabusSections && syllabusSections.length > 0
    ? { "syllabusSections": syllabusSections }
    : {}),
  "educationalLevel": Astro.props.educationalLevel || ["Beginner"],
  "courseMode": Astro.props.courseMode || ["Online"],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": ratingValue || "4.7",
    "reviewCount": reviewCount || "929",
    "bestRating": "5",
    "worstRating": "1"
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "name": title,
    "description": description,
    "datePublished": Astro.props.datePublished,
    "courseMode": "Online",
    "courseWorkload": isoDuration || "PT2H",
    "inLanguage": "fr-FR",
    "instructor": {
      "@type": "Person",
      "name": "Fred Fieffé",
      "url": "https://musique-facile.fr/a-propos/"
    }
  },
  // Sans prix déclaré, on n'émet pas d'Offer plutôt qu'une offre à 0 € marquée
  // « payante » — une contradiction que Google rejette.
  ...(Astro.props.hasCourseInstance?.offers
    ? {
        "offers": {
          "@type": "Offer",
          ...Astro.props.hasCourseInstance.offers,
          "validFrom": Astro.props.datePublished,
          "url": Astro.url.toString(),
          "isAccessibleForFree": false
        }
      }
    : {})
};

---

<!doctype html>
<html lang="fr">
  <head>
    <!-- Consentement cookies + GTM (chargé après consentement) -->
    <ConsentManager />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={Astro.url.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.toString()} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.toString()} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />


    <!-- Schema.org -->
    <JsonLD data={courseSchema} />


    <ExternalResources loadVideoScripts={true} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class={`theme-${theme}`}>
      <Header />
      <main>
        <slot />
      </main>
      <FooterModern />
    </div>
    <script is:inline define:vars={{ courseTitle: title, courseUrl: Astro.url.toString(), courseTheme: theme }}>
      (() => {

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'view_course',
          course_title: courseTitle,
          course_url: courseUrl,
          course_theme: courseTheme
        });

        document.addEventListener('DOMContentLoaded', () => {
          const primaryCta = document.querySelector('.hero .cta-group a');
          if (!primaryCta) return;

          primaryCta.addEventListener('click', () => {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'click_cta_course',
              course_title: courseTitle,
              course_url: courseUrl,
              course_theme: courseTheme,
              cta_text: (primaryCta.textContent || '').trim(),
              cta_href: primaryCta.getAttribute('href') || ''
            });
          }, { passive: true });
        });
      })();
    </script>
  </body>
</html>


<style is:global>
  /* ==================================================================
     HERO
     Fond clair, couleur d'instrument en accent. L'ancienne version
     superposait un aplat vert à 90 % d'opacité sur la photo : l'image
     disparaissait et tous les textes tombaient à 2,8:1 de contraste.
     ================================================================== */
  .hero {
    position: relative;
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    background:
      radial-gradient(120% 90% at 88% 0%, var(--theme-soft) 0%, transparent 60%),
      var(--bg-page);
    border-bottom: 1px solid var(--border-default, rgba(0, 0, 0, .08));
  }

  .hero-content {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
    gap: clamp(2rem, 3.5vw, 3.25rem);
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    background: var(--theme-soft);
    color: var(--theme-ink);
    border: 1px solid var(--theme-line);
    padding: .35rem .85rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-size: clamp(1.95rem, 1.15rem + 2.6vw, 3.05rem);
    color: var(--text-primary);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 16ch;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: clamp(1rem, .96rem + .25vw, 1.125rem);
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 46ch;
    margin-bottom: 1.75rem;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  /* ------------------------------------------------------------------
     CTA principal.
     Le bouton précédent héritait de `.btn` (inline-flex, nowrap,
     overflow:hidden) tout en plaçant le prix dans un enfant `display:block` :
     les deux textes se retrouvaient sur une ligne, plus large que le bouton,
     et la fin était rognée (« …ou 3x 30€ sans fra »). Ici les deux lignes
     sont empilées et rien ne peut déborder.
     ------------------------------------------------------------------ */
  .btn-cta {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .1rem;
    padding: .85rem 1.6rem;
    min-height: 52px;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    background: var(--theme-surface);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: var(--font-semibold);
    font-size: var(--text-lg);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--theme-surface) 30%, transparent);
    transition: background var(--transition-base), transform var(--transition-base);
  }

  .btn-cta:hover {
    background: var(--theme-deep);
    transform: translateY(-2px);
    color: #fff;
  }

  .btn-cta:focus-visible {
    outline: 3px solid var(--theme-ink);
    outline-offset: 3px;
  }

  .btn-cta-price {
    font-size: var(--text-sm);
    font-weight: var(--font-normal, 400);
    opacity: .92;
  }

  /* Variante sur fond déjà coloré (mid-CTA, bande finale) */
  .btn-cta-invert {
    background: #fff;
    color: var(--theme-deep);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .18);
  }

  .btn-cta-invert:hover {
    background: #fff;
    color: var(--theme-deep);
  }

  .btn-cta-invert:focus-visible {
    outline-color: #fff;
  }

  .hero-guarantee {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  .hero-guarantee :global(.icon) {
    color: var(--theme-ink);
  }

  /* ------------------------------------------------------------------
     Fiche technique du hero.
     Disposition en flux, pas en grille : quel que soit le nombre de faits
     déclarés (3, 4 ou davantage), aucune cellule vide ne peut apparaître.
     ------------------------------------------------------------------ */
  .hero-facts {
    margin: 2rem 0 0;
    padding: 1.15rem 0;
    border-top: 1px solid var(--border-default, rgba(0, 0, 0, .08));
    border-bottom: 1px solid var(--border-default, rgba(0, 0, 0, .08));
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem 2.25rem;
  }

  .hero-fact {
    display: flex;
    align-items: center;
    gap: .7rem;
    flex: 1 1 auto;
    min-width: max-content;
  }

  .hero-fact-icon {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--theme-soft);
    color: var(--theme-ink);
    border: 1px solid var(--theme-line);
  }

  .hero-fact dd {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-semibold);
    font-size: 1.3125rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .hero-fact dt {
    font-size: var(--text-sm);
    color: var(--text-muted, #6a6382);
    line-height: 1.3;
  }

  /* ------------------------------------------------------------------
     Façade vidéo : image d'abord, iframe au clic.
     ------------------------------------------------------------------ */
  .video-facade {
    position: relative;
    border-radius: var(--radius-2xl, 20px);
    overflow: hidden;
    box-shadow: var(--shadow-lg, 0 12px 32px rgba(0, 0, 0, .12));
    aspect-ratio: 16 / 9;
    background: var(--bg-elevated, #e9e4f1);
  }

  .video-facade img,
  .video-facade iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
    display: block;
  }

  .video-facade::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(10, 8, 14, .45) 100%);
    pointer-events: none;
  }

  .video-facade.is-playing::after {
    display: none;
  }

  .video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, .94);
    color: var(--theme-deep);
    box-shadow: 0 8px 28px rgba(10, 8, 14, .35);
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .video-play:hover {
    transform: scale(1.06);
  }

  .video-play:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  @media (max-width: 900px) {
    .hero-content {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: none;
    }

    .hero-media {
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .cta-group {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-cta {
      width: 100%;
    }

    .hero-guarantee {
      justify-content: center;
    }
  }

  /* Timeline Section */
  .timeline {
    padding: 8rem 0;
    background: var(--bg-light);
  }

  .timeline-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 4rem;
    color: var(--theme-ink);
  }

  .timeline-wrapper {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .timeline-wrapper::before {
    content: '';
    position: absolute;
    left: 50px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--theme-surface);
  }

  .timeline-item {
    display: flex;
    gap: 2rem;
    margin-bottom: 4rem;
    position: relative;
  }

  .timeline-number {
    width: 100px;
    height: 100px;
    background: var(--theme-surface);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: bold;
    flex-shrink: 0;
    box-shadow: 0 0 0 8px var(--bg-light), 0 0 0 10px var(--theme-ink);
  }

  .timeline-content {
    flex: 1;
    /* Sans `min-width: 0`, un élément flex ne descend jamais sous la largeur
       intrinsèque de son contenu : la carte débordait de 5 px sur mobile. */
    min-width: 0;
    background: #ffffff !important;
    border-radius: var(--border-radius);
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .timeline-header h3 {
    color: var(--theme-ink);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .timeline-objective {
    color: #444444 !important;
    opacity: 1;
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .timeline-body {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
  }

  .timeline-image-wrapper {
    position: relative;
  }

  .timeline-image {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: var(--border-radius);
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .timeline-image:hover {
    transform: scale(1.05);
  }

  .timeline-details {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-details li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.8rem;
    line-height: 1.6;
    color: #333333 !important;
  }

  .timeline-details li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--theme-ink);
  }

  /* Modal Styles */
  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    z-index: 1000;
    backdrop-filter: blur(5px);
  }

  .modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-content {
    position: relative;
    max-width: 90%;
    max-height: 90vh;
  }

  .modal-content img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .close-modal {
    position: absolute;
    top: -40px;
    right: 0;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .timeline-body {
      grid-template-columns: 1fr;
    }

    .timeline-wrapper::before {
      left: 30px;
    }

    .timeline-item {
      gap: 1rem;
    }

    .timeline-number {
      width: 60px;
      height: 60px;
      font-size: 1.5rem;
      box-shadow: 0 0 0 4px var(--bg-light), 0 0 0 6px var(--theme-ink);
    }
  }


  /* Frustrations Section */
  .frustrations {
    padding: 6rem 0;
    background: var(--bg-light);
    position: relative;
    overflow: hidden;
  }

  .frustrations::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-primary);
  }

  .frustrations-title {
    text-align: center;
    font-size: 2.5rem;
    max-width: 800px;
    margin: 0 auto 3rem;
    color: var(--theme-ink);
    line-height: 1.3;
  }

  .frustrations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto 3rem;
  }

  .frustration-card {
    background: white;
    padding: 2rem;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.3s ease;
  }

  .frustration-card:hover {
    transform: translateY(-5px);
  }

  .frustration-icon {
    font-size: 2.5rem;
    background: var(--bg-light);
    width: 70px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .frustration-text {
    font-size: 1.1rem;
    color: var(--color-dark);
    margin: 0;
    line-height: 1.5;
  }

  .solution-banner {
    background: var(--theme-surface);
    padding: 2rem;
    border-radius: var(--border-radius);
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    transform: translateY(20px);
    animation: float 3s ease-in-out infinite;
  }

  .solution-text {
    color: white;
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (max-width: 768px) {
    .frustrations-title {
      font-size: 2rem;
      padding: 0 1rem;
    }

    .frustrations-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }

    .frustration-card {
      padding: 1.5rem;
    }

    .solution-banner {
      margin: 0 1rem;
    }

    .solution-text {
      font-size: 1.2rem;
    }
  }

/* Valeur Unique Section */
/* ==================================================================
   VALEUR UNIQUE
   Ancien fond anthracite en dur (#1a1a1a) : une tache sombre au milieu
   de la page, insensible au thème clair/sombre, avec un titre en
   background-clip qui passait sous le seuil de contraste.
   ================================================================== */
.valeur-unique {
  padding: clamp(3rem, 6vw, 5rem) 0;
  background: var(--theme-soft);
  border-block: 1px solid var(--theme-line);
}

.valeur-unique-content {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.valeur-unique h2 {
  color: var(--theme-ink);
  font-size: clamp(1.65rem, 1.1rem + 2vw, 2.5rem);
  line-height: 1.15;
  letter-spacing: -0.02em;
  text-wrap: balance;
  margin-bottom: 1rem;
}

.valeur-unique .description {
  color: var(--text-secondary);
