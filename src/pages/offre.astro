---
/**
 * offre.astro — l'offre de rentrée : un Pack par instrument, 99 €, une fois.
 *
 * Refonte du 2026-09-04 dans les codes de la nouvelle home (/home-v2/) :
 * hero encre, papier et encre ensuite, Bricolage Grotesque + Instrument Serif,
 * accent par instrument, engagements sourcés en notes, avis recopiés mot pour
 * mot avec leur source, calendrier réel. Les données (packs, prix, date de
 * fin, FAQ) viennent de src/data/home-v2.ts : une seule source pour la home et
 * cette page.
 *
 * Ce que la page ne fait plus (version précédente) : cadeau physique, « offre
 * limitée » sans date, pourcentage d'économie, chiffres YouTube/TikTok non
 * sourcés, témoignages inventés. Le « pris séparément » est la somme des prix
 * des fiches cours, et la note 5 le précise.
 */
import '@fontsource-variable/rubik/wght.css';
import '@fontsource-variable/rubik/wght-italic.css';
import '@fontsource-variable/shantell-sans/full.css';
import '../styles/experience-fonts.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterModern from '../components/FooterModern.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import { paths, pianoAdvancedOffer, offerFaq, reassurance, rentree, fred } from '../data/home-v2';
import { testimonials, formatTestimonialDate } from '../data/testimonials';
import { rating, reviews, students, videos, reviewsSource } from '../data/proof';

const site = 'https://musique-facile.fr';
const canonicalURL = `${site}/offre/`;
const title = 'Offre de rentrée : le Pack guitare, piano ou ukulélé à 99 € | Musique Facile';
const description = `Jusqu'au ${rentree.offerEndsLabel} : un Pack par instrument à 99 €, deux ou trois formations complètes de Fred Fieffé, accès à vie, 15 jours remboursé.`;
const ogImage = '/images/og-home.webp';

const byId = Object.fromEntries(paths.map((p) => [p.id, p]));
const packs = [
  {
    id: 'guitare',
    theme: 'guitar',
    object: 'la guitare',
    level: 'Débutant',
    offer: byId.guitar.offer,
    audience: byId.guitar.audience,
    firstWin: byId.guitar.firstWin,
    image: byId.guitar.image,
    imageAlt: byId.guitar.imageAlt,
  },
  {
    id: 'ukulele',
    theme: 'ukulele',
    object: 'le ukulélé',
    level: 'Débutant',
    offer: byId.ukulele.offer,
    audience: byId.ukulele.audience,
    firstWin: byId.ukulele.firstWin,
    image: byId.ukulele.image,
    imageAlt: byId.ukulele.imageAlt,
  },
  {
    id: 'piano-debutant',
    theme: 'piano',
    object: 'le piano',
    level: 'Débutant',
    offer: byId.piano.offer,
    audience: byId.piano.audience,
    firstWin: byId.piano.firstWin,
    image: byId.piano.image,
    imageAlt: byId.piano.imageAlt,
  },
  {
    id: 'piano-avance',
    theme: 'piano',
    object: 'le piano',
    level: 'Déjà pianiste',
    offer: pianoAdvancedOffer,
    audience: 'Vous jouez déjà, et vous voulez de la technique, de l’harmonie et un an de progression guidée.',
    firstWin: 'Un plan sur 52 semaines, avec le cycle des quintes et les accords',
    image: '/images/cours/maitrise-technique-piano-avancee/timeline-1.webp',
    imageAlt: 'Écran du cours de piano avancé : Fred et un musicien invité au clavier, les mains filmées du dessus',
  },
];
const LABELS = { guitar: 'Guitare', piano: 'Piano', ukulele: 'Ukulélé', solfege: 'Solfège' } as const;
const quotes = testimonials.filter((t) => t.id !== 'gaetane-c-2025-10');
const checkedOn = new Date(reviewsSource.checkedOn)
  .toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  .replace(/^1 /, '1er ');

const productList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Packs Musique Facile, offre de rentrée 2026',
  itemListElement: packs.map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: k.offer.name,
      description: `${k.offer.includes.map((x) => x.title).join(', ')}. Accès à vie, un seul paiement.`,
      image: `${site}${k.image}`,
      brand: { '@type': 'Brand', name: 'Musique Facile' },
      offers: {
        '@type': 'Offer',
        price: String(k.offer.priceValue),
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: k.offer.url,
        priceValidUntil: rentree.offerEnds,
        seller: { '@type': 'Organization', name: 'Musique Facile' },
      },
    },
  })),
};
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: offerFaq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalURL}
  robots="index, follow, max-snippet:-1, max-image-preview:large"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productList)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
  </Fragment>

  <Header />

  <div class="ov xp">
    <!-- 1. Le prix, en grand -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">{rentree.offerLabel} · jusqu'au {rentree.offerEndsLabel}</p>
          <h1 id="hero-title">Quatre Packs, un prix. <em>Et rien à résilier.</em></h1>
          <p class="hero__lead">
          Guitare, ukulélé, piano débutant ou piano avancé : chaque Pack regroupe deux ou trois formations complètes de
          Fred Fieffé, pour apprendre en jouant des morceaux. Vous payez une fois, vous gardez l'accès à vie. Si ça ne
          vous convient pas, quinze jours pour changer d'avis, un e-mail suffit.
        </p>
          <div class="hero__actions">
            <a href="#packs" class="btn btn--primary">Choisir mon Pack</a>
            <a href="#parcours" class="btn btn--ghost">Comment ça se passe</a>
          </div>
          <p class="hero__proof">
            <strong>{rating.display}</strong> sur
            <a href={reviewsSource.url} rel="noopener nofollow" target="_blank">{reviews.display} avis vérifiés</a>
            · <strong>{students.display}</strong> élèves depuis 2015
          </p>
        </div>
        <p class="tag" aria-label="99 euros, en une fois">
          <span class="tag__price">99 €</span>
          <span class="tag__line">en une fois, accès à vie</span>
          <span class="tag__line tag__line--small">
            pour 187 à 378 € de formations prises séparément<sup><a href="#note-5" aria-label="Note 5">5</a></sup>
          </span>
        </p>
      </div>
    </section>

    <!-- 2. Les quatre Packs -->
    <section class="packs" id="packs" aria-labelledby="packs-title">
      <div class="container">
        <p class="eyebrow">Quatre Packs, un prix</p>
        <h2 id="packs-title">Lequel vous fait <em>envie</em> ?</h2>
      </div>
      <div class="container packs__grid">
        {packs.map((k) => (
          <article class={`pack theme-${k.theme}`} id={`pack-${k.id}`}>
            <figure class="pack__shot taped">
              <img src={k.image} alt={k.imageAlt} width="1824" height="1042" loading="lazy" decoding="async" />
              <figcaption>{k.level}</figcaption>
            </figure>
            <div class="pack__body">
              <h3>{k.offer.name}</h3>
              <p class="pack__who">{k.audience}</p>
              <ul class="pack__list" role="list">
                {k.offer.includes.map((item) => (
                  <li>
                    <span>{item.title}</span>
                    <span class="pack__each">{item.price} seul</span>
                  </li>
                ))}
              </ul>
              <p class="pack__price">
                <strong>{k.offer.price}</strong>
                <span>
                  pour {k.offer.separately} pris séparément<sup><a href="#note-5" aria-label="Note 5">5</a></sup>
                </span>
              </p>
              <a href={k.offer.url} class="btn btn--primary btn--wide" data-analytics={`cta-${k.id}`}>
                Commencer {k.object} · {k.offer.price}
              </a>
              <p class="pack__terms">
                Paiement unique · accès à vie · 15 jours pour changer d'avis · jusqu'au {rentree.offerEndsShort}
              </p>
            </div>
          </article>
        ))}
      </div>
      <div class="container">
        <ul class="assure" role="list">
          {reassurance.map((r, i) => (
            <li>
              <span>{r.label}</span>
              <sup><a href={`#note-${i + 1}`} aria-label={`Note ${i + 1}`}>{i + 1}</a></sup>
            </li>
          ))}
        </ul>
        <p class="guarantee">
          <strong>Quinze jours pour changer d'avis.</strong> Vous achetez, vous suivez les leçons. Si ça ne vous convient
          pas, un message depuis <a href="/contact/">la page contact</a> suffit : vous êtes remboursé. Ensuite, l'accès
          reste ouvert à vie, mises à jour comprises. Vous hésitez encore ?
          <a href="/on-discute/">On en discute deux minutes avec Fred</a>. Le solfège n'a pas de Pack : le cours
          <a href={byId.solfege.courseUrl}>Lire les Notes de Musique</a> coûte {byId.solfege.price}, et il est compris dans
          le Pack Piano Débutant.
        </p>
      </div>
    </section>

    <!-- 3. Comment ça se passe -->
    <section class="how" id="parcours" aria-labelledby="how-title">
      <div class="container">
        <p class="eyebrow">Après l'achat</p>
        <h2 id="how-title">Comment <em>ça se passe</em></h2>
        <ol class="how__list" role="list">
          <li>
            <span class="how__n">1</span>
            <h3>Vos accès arrivent par e-mail</h3>
            <p>Dans les 24 heures. Vous vous connectez sur la plateforme de l'école, et les formations du Pack sont là, toutes, tout de suite.</p>
          </li>
          <li>
            <span class="how__n">2</span>
            <h3>Vous suivez le parcours, dans l'ordre</h3>
            <p>Des vidéos courtes, une notion à la fois, un exercice à chaque étape. Quinze minutes par jour suffisent, et vous revenez en arrière autant de fois que nécessaire.</p>
          </li>
          <li>
            <span class="how__n">3</span>
            <h3>Vous jouez un morceau en entier</h3>
            <p>À la guitare, les premiers morceaux arrivent en 30 jours ; au ukulélé, en trois semaines ; au piano, vous jouez dès la première leçon. Ensuite vous enchaînez, sans abonnement à renouveler.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- 4. Le public -->
    <section class="public" aria-labelledby="public-title">
      <div class="container">
        <p class="eyebrow">Le public</p>
        <h2 id="public-title">Des adultes qui ont commencé <em>exactement là où vous êtes</em></h2>
        <p class="public__rating">
          <strong>{rating.display}</strong> sur
          <a href={reviewsSource.url} rel="noopener nofollow" target="_blank">{reviews.display} avis Skilleos</a>, relevé
          le {checkedOn}. Recopiés mot pour mot.
        </p>
        <ul class="quotes" role="list">
          {quotes.map((t) => (
            <li class={`quote theme-${t.instrument}`}>
              <blockquote cite={t.sourceUrl}>
                <p>« {t.quote} »</p>
                <footer>
                  <strong>{t.name}</strong> · {LABELS[t.instrument]} · {formatTestimonialDate(t.date, t.datePrecision)}
                  {t.sourceUrl && (
                    <> · <a href={t.sourceUrl} rel="noopener nofollow" target="_blank">{t.sourceName}</a></>
                  )}
                </footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Le prof -->
    <section class="prof" aria-labelledby="prof-title">
      <div class="container prof__grid">
        <figure class="prof__visual taped">
          <img src={fred.photo} alt="Fred Fieffé, souriant, un ukulélé à la main, devant un feuillage" width="800" height="800" loading="lazy" decoding="async" />
          <figcaption>Fred Fieffé</figcaption>
        </figure>
        <div>
          <p class="eyebrow">Votre prof</p>
          <h2 id="prof-title">Je m'appelle Fred. <em>Je serai votre seul prof.</em></h2>
          <p>
            Je joue depuis plus de quarante ans et j'enseigne en ligne depuis 2015. Sur les parcours débutant, c'est ma
            voix sur chaque leçon, du premier accord au dernier morceau, sur {videos.display} vidéos. Ce que j'ai appris
            en {students.display} élèves tient en une phrase : un adulte qui débute n'a pas besoin de théorie, il a
            besoin de jouer quelque chose dès la première semaine.
          </p>
          <ul class="prof__creds" role="list">
            {fred.credentials.map((c) => <li>{c}</li>)}
          </ul>
          <p class="prof__links">
            <a href={fred.aboutUrl}>Mon parcours en détail</a>
            <a href="/carnet/">Ouvrir le carnet de rentrée</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 6. FAQ -->
    <HomeFaq heading="Les questions qu'on me pose avant d'acheter" items={offerFaq} />

    <!-- 7. Dernier appel, avec le calendrier réel -->
    <section class="final" aria-labelledby="final-title">
      <div class="container final__grid">
        <div>
          <p class="eyebrow">{rentree.season}</p>
          <h2 id="final-title">{rentree.claim}<em>.</em></h2>
          <div class="final__btns">
            {packs.map((k) => (
              <a href={k.offer.url} class={`btn btn--final theme-${k.theme}`} data-analytics={`final-cta-${k.id}`}>
                {k.offer.name} · {k.offer.price}
              </a>
            ))}
          </div>
          <p class="final__terms">
            {rentree.offerLabel} jusqu'au {rentree.offerEndsLabel} · paiement unique · accès à vie · 15 jours pour changer
            d'avis
          </p>
        </div>
        <ol class="cal" aria-label="Repères du programme">
          <li>
            <span class="cal__k">Aujourd'hui</span>
            <span>Vos accès par e-mail, leçon 1 dans la foulée.</span>
          </li>
          <li>
            <span class="cal__k">Jour 30</span>
            <span>À la guitare, les premiers morceaux ; au ukulélé, les premières chansons ; au piano, une ballade en version simplifiée.</span>
          </li>
          <li>
            <span class="cal__k">{rentree.toussaintLabel}</span>
            <span>
              Début des vacances de la Toussaint<sup><a href="#note-6" aria-label="Note 6">6</a></sup>
            </span>
          </li>
        </ol>
      </div>
    </section>

    <!-- 8. Notes -->
    <section class="notes" aria-label="Notes et sources">
      <div class="container">
        <ol>
          {reassurance.map((r, i) => (
            <li id={`note-${i + 1}`}>
              {r.note} <a href={r.href}>Voir {r.linkLabel}</a>.
            </li>
          ))}
          <li id="note-5">
            Somme des prix de chaque formation prise seule, tels qu'affichés sur leurs fiches cours le 4 septembre 2026 :
            187 € pour le Pack Ukulélé, 267 € pour le Pack Guitare, 307 € pour le Pack Piano Avancé, 378 € pour le Pack
            Piano Débutant. Ce n'est pas un ancien prix du Pack. <a href="/cours/">Voir les fiches cours</a>.
          </li>
          <li id="note-6">{rentree.source} Vacances de la Toussaint {rentree.toussaintRange}, toutes zones.</li>
        </ol>
      </div>
    </section>

    <!-- Sur téléphone : le bouton suit -->
    <div class="mcta" data-mcta>
      <a href="#packs" class="mcta__btn">Choisir mon Pack · 99 €</a>
    </div>
  </div>

  <FooterModern />
</Layout>

<script is:inline>
  (() => {
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[data-analytics]').forEach((element) => {
        if (!(element instanceof HTMLAnchorElement)) return;
        element.addEventListener(
          'click',
          () => {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'click_cta_course',
              page_type: 'offer',
              cta_label: element.getAttribute('data-analytics') || '',
              cta_href: element.getAttribute('href') || '',
            });
          },
          { passive: true },
        );
      });
    });
  })();
</script>

<script>
  // Bouton mobile : visible une fois le premier écran passé, caché devant les Packs et le dernier appel.
  const mcta = document.querySelector<HTMLElement>('[data-mcta]');
  const hero = document.querySelector('.hero');
  const hide = [...document.querySelectorAll('#packs, .final')];
  if (mcta && hero && 'IntersectionObserver' in window) {
    let pastHero = false;
    const onHide = new Set<Element>();
    const update = () => mcta.classList.toggle('is-visible', pastHero && onHide.size === 0);
    new IntersectionObserver(
      ([e]) => {
        pastHero = !e.isIntersecting && e.boundingClientRect.bottom < 0;
        update();
      },
      { threshold: 0 },
    ).observe(hero);
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? onHide.add(e.target) : onHide.delete(e.target)));
        update();
      },
      { threshold: 0.05 },
    );
    hide.forEach((el) => io.observe(el));
  }
</script>

<style>
  .ov {
    --hv-header: 80px;
    --ov-display: var(--xp-display);
    --ov-serif: var(--xp-display);
    --ov-paper: #f6f0e4;
    --ov-paper-2: #ede4d3;
    --ov-card: #fffaf0;
    --ov-ink: #23193d;
    --ov-ink-2: #5a4f75;
    --ov-line: rgba(35, 25, 61, 0.16);
    --ov-sun: #ffcf5a;
    --ov-sun-ink: #3a2a00;
    --ov-hand: var(--xp-voice);
    --ov-stage: #6c3fa0;
    --ov-accent: var(--brand-500);
    --ov-accent-ink: var(--brand-600);
    --ov-accent-line: #c9b3e6;
    color-scheme: light;
    --bg-page: var(--ov-paper);
    --bg-alt: var(--ov-paper-2);
    --bg-card: var(--ov-card);
    --bg-elevated: var(--ov-card);
    --text-primary: var(--ov-ink);
    --text-secondary: var(--ov-ink-2);
    --text-muted: var(--ov-ink-2);
    --border-default: var(--ov-line);
    --surface-white: var(--ov-card);
    --surface-light: var(--ov-paper);
    background: var(--ov-paper);
    color: var(--ov-ink);
    font-family: var(--xp-text);
  }

  .ov .tag__line, .ov .pack__shot figcaption {
    font-variation-settings: var(--xp-voice-settings);
  }

  @media (max-width: 768px) {
    .ov {
      --hv-header: 70px;
    }
  }

  .ov [id] {
    scroll-margin-top: calc(var(--hv-header) + var(--space-4));
  }

  .ov h1,
  .ov h2,
  .ov h3 {
    font-family: var(--ov-display);
    font-variation-settings: var(--xp-display-settings);
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--ov-ink);
  }

  .ov h1 em,
  .ov h2 em {
    font-family: var(--ov-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--ov-accent-ink);
    letter-spacing: 0;
  }

  .ov p {
    text-wrap: pretty;
  }

  .ov a:not(.btn, .mcta__btn) {
    color: inherit;
  }

  .ov :global(.hfaq__head h2),
  .ov :global(.hfaq summary) {
    font-family: var(--ov-display);
    letter-spacing: -0.02em;
  }

  .ov :global(.hfaq) {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ov-accent-ink);
  }

  sup a {
    text-decoration: none;
    color: var(--ov-accent-ink);
    font-size: 0.75em;
  }

  /* ---------- boutons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--ov-display);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--ov-sun);
    color: var(--ov-sun-ink);
    box-shadow: 0 6px 0 -2px rgba(35, 25, 61, 0.18);
  }

  .btn--primary:hover {
    background: var(--ov-ink);
    color: var(--ov-paper);
    transform: translateY(-2px);
  }

  .btn--ghost {
    color: var(--ov-ink);
    border: 1px solid var(--ov-line);
  }

  .btn--wide {
    width: 100%;
  }

  .btn:focus-visible {
    outline: 3px solid var(--theme-current, var(--ov-accent));
    outline-offset: 3px;
  }

  /* =========================================================
     1. Hero encre
     ========================================================= */
  .hero {
    padding: calc(var(--hv-header) + var(--space-10)) 0 var(--space-12);
    background: var(--ov-stage);
    color: var(--ov-paper);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  .hero .eyebrow {
    color: rgba(246, 240, 228, 0.8);
  }

  .hero h1 {
    color: var(--ov-paper);
    font-size: clamp(2.3rem, 4.4vw, 3.8rem);
    line-height: 1.02;
    margin: 0 0 var(--space-5);
    font-weight: 700;
  }

  .hero h1 em {
    color: var(--ov-sun);
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' preserveAspectRatio='none'><path d='M3 9 C 40 3, 70 12, 110 6 S 170 4, 197 8' fill='none' stroke='%23ffcf5a' stroke-width='3.5' stroke-linecap='round'/></svg>") no-repeat left 100% / 100% 0.32em;
    padding-bottom: 0.08em;
  }

  .hero__lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: rgba(246, 240, 228, 0.86);
    max-width: 56ch;
    margin: 0 0 var(--space-6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
