---
import { getCollection } from 'astro:content';
import CourseLayout from '../../layouts/CourseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import RelatedCourses from '../../components/RelatedCourses.astro';
import StickyCTAMobile from '../../components/StickyCTAMobile.astro';
import CourseTargetAudience from '../../components/CourseTargetAudience.astro';
import CourseIncludes from '../../components/CourseIncludes.astro';
import CoursePricing from '../../components/CoursePricing.astro';
import Icon from '../../components/Icon.astro';
import ContentIcon from '../../components/ContentIcon.astro';
import Avatar from '../../components/Avatar.astro';
import { emojiToIcon } from '../../utils/emojiToIcon';
import { publicAssetExists } from '../../utils/publicAsset';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map(course => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
// Récupération du slug dès le début (utilisé dans les schemas)
const { slug } = Astro.params;

// Corps markdown optionnel : rendu en section « Programme détaillé » sous la
// timeline. Les fiches sans corps (la majorité) ne rendent rien de plus.
const { Content } = await course.render();
const hasDetailedProgram = course.body.trim().length > 0;

const {
  title,
  description,
  ogImage,
  theme,
  hero,
  timeline,
  teachers,
  frustrations,
  valeurUnique,
  preuveSociale,
  benefices,
  cta,
  faq,
  ratingValue,
  reviewCount,
  transformation,
  pricing,
  targetAudience,
  courseIncludes
} = course.data;

// Schema.org Review pour les témoignages du cours.
// Pas de `reviewRating` : les témoignages du frontmatter ne portent aucune
// note. En coder une (5/5) reviendrait à inventer un avis, et contredirait
// l'aggregateRating de la page. Un Review sans note reste valide.
const reviewSchemas = preuveSociale.testimonials.map((testimonial) => ({
  "@context": "https://schema.org",
  "@type": "Review",
  "author": {
    "@type": "Person",
    "name": testimonial.author
  },
  "reviewBody": testimonial.text,
  "itemReviewed": {
    "@type": "Course",
    "name": title,
    "provider": {
      "@type": "Organization",
      "name": "Musique Facile"
    }
  },
  "datePublished": course.data.datePublished
}));

// Programme → `syllabusSections`, rattaché au Course du layout.
// (Le HowTo précédent ne produit plus aucun résultat enrichi : Google a retiré
// ce type de la recherche en 2023. `Syllabus` est le vocabulaire des cours.)
const syllabusSections = timeline.map((item) => ({
  "@type": "Syllabus",
  "position": item.number,
  "name": item.title,
  "description": item.objective,
  "abstract": item.details.join(' ')
}));

// Schema.org FAQPage pour les questions fréquentes du cours
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.questions.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};

const offerSchema = {
  "@context": "https://schema.org",
  "@type": "Offer",
  "price": course.data.hasCourseInstance?.offers?.price || "79.00",
  "priceCurrency": course.data.hasCourseInstance?.offers?.priceCurrency || "EUR",
  "availability": course.data.hasCourseInstance?.offers?.availability || "https://schema.org/InStock",
  "url": Astro.url.toString(),
  "itemOffered": {
    "@type": "Course",
    "name": title,
    "url": Astro.url.toString()
  }
};

// Découpe une durée ISO 8601. Tolère les valeurs mal formées présentes dans le
// contenu (« PT2H40 », sans le M final) plutôt que de les perdre en silence.
function splitDuration(iso: string | undefined): { hours: number; minutes: number } | null {
  if (!iso) return null;
  const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M?)?/);
  if (!match) return null;
  const hours = match[1] ? parseInt(match[1], 10) : 0;
  const minutes = match[2] ? parseInt(match[2], 10) : 0;
  if (!hours && !minutes) return null;
  return { hours, minutes };
}

// Durée lisible par un humain : « 2h30 », « 4h », « 45min ».
function formatDuration(iso: string | undefined): string {
  const parts = splitDuration(iso);
  if (!parts) return '';
  const { hours, minutes } = parts;
  if (hours && minutes) return `${hours}h${minutes.toString().padStart(2, '0')}`;
  if (hours) return `${hours}h`;
  return `${minutes}min`;
}

// Durée ISO 8601 valide pour les schemas (Google ignore une durée mal formée).
function normalizeDuration(iso: string | undefined): string | undefined {
  const parts = splitDuration(iso);
  if (!parts) return undefined;
  const { hours, minutes } = parts;
  return `PT${hours ? `${hours}H` : ''}${minutes ? `${minutes}M` : ''}`;
}

const rawDuration = course.data.hasCourseInstance?.duration;
const courseDuration = formatDuration(rawDuration);
const isoDuration = normalizeDuration(rawDuration);

// Fonction utilitaire pour construire les chemins d'images
function getCoursePaths(slug: string) {
  return {
    hero: `/images/cours/${slug}/hero.webp`,
    timeline: (index: number) => `/images/cours/${slug}/timeline-${index}.webp`,
    testimonial: (index: number) => `/images/cours/${slug}/testimonial-${index}.webp`
  };
}

// Obtention des chemins d'images pour ce cours
const imagePaths = getCoursePaths(slug);

// Visuel du hero : repli sur l'image Open Graph si la fiche n'a pas son hero.webp
const heroImage = publicAssetExists(imagePaths.hero) ? imagePaths.hero : ogImage;

// Répartir les témoignages : le premier après le programme, les autres après le prix
const allTestimonials = preuveSociale.testimonials;
const firstTestimonial = allTestimonials.length > 0 ? allTestimonials[0] : null;
const remainingTestimonials = allTestimonials.length > 1 ? allTestimonials.slice(1) : [];

// Extraire le nombre de chapitres depuis hero.stats pour CourseIncludes
const chaptersFromStats = hero.stats.find(s => s.label.includes('chapitre'))?.value;

// Construire les features pour CoursePricing
const pricingFeatures = pricing?.features || cta.features.map(f => f.text);

// ----------------------------------------------------------------------
// « En bref » : bloc answer-first, construit uniquement depuis le frontmatter
// existant (aucune rédaction à ajouter dans les 18 fiches).
//
// Un paragraphe autonome qui répond seul à « c'est quoi, avec qui, combien de
// leçons, combien de temps, combien ça coûte, quel risque » — c'est ce format
// que citent les moteurs de réponse (ChatGPT, Perplexity, AI Overviews).
// ----------------------------------------------------------------------
const mainTeacher = teachers.mainTeachers?.[0];
const teacherFullName = mainTeacher ? `${mainTeacher.firstName} ${mainTeacher.lastName}` : null;
const lessonCount = hero.stats.find(s => /chapitre|le[çc]on|vid[ée]o/i.test(s.label))?.value;
const moduleCount = timeline.length;

// Les titres portent souvent un suffixe SEO (« … — Accès à Vie ») qui sonne
// faux au milieu d'une phrase : on ne garde que le nom du cours.
const courseName = title.split(/\s+—\s+|\s+:\s+/)[0].trim();

// Prix à la française : le frontmatter stocke « 89.00 ».
function formatPrice(raw: string | undefined): string | null {
  if (!raw) return null;
  const value = Number(raw);
  if (Number.isNaN(value)) return null;
  return Number.isInteger(value)
    ? `${value} €`
    : `${value.toFixed(2).replace('.', ',')} €`;
}
const priceLabel = formatPrice(course.data.hasCourseInstance?.offers?.price);

// Toutes les fiches ne déclarent pas un nombre de leçons : la phrase doit
// rester grammaticale avec les seules données présentes.
function describeContent(): string {
  const modules = moduleCount ? `${moduleCount} module${moduleCount > 1 ? 's' : ''}` : null;
  const duration = courseDuration ? `soit ${courseDuration} de contenu` : null;

  let core: string;
  if (lessonCount && modules) {
    core = `Elle compte ${lessonCount} leçons vidéo, réparties en ${modules}`;
  } else if (lessonCount) {
    core = `Elle compte ${lessonCount} leçons vidéo`;
  } else if (modules) {
    core = `Elle compte ${modules}`;
  } else {
    core = 'Elle se suit à son rythme';
    return duration ? `${core}, ${duration}.` : `${core}.`;
  }

  return [core, duration].filter(Boolean).join(', ') + ', à suivre à son rythme.';
}

const briefSentences = [
  `« ${courseName} » est une formation en ligne de Musique Facile${teacherFullName ? `, animée par ${teacherFullName}` : ''}.`,
  describeContent(),
  priceLabel
    ? `Elle coûte ${priceLabel} en paiement unique, avec accès à vie et remboursement sous 15 jours.`
    : `L'accès se fait en paiement unique, à vie, avec remboursement sous 15 jours.`,
].filter(Boolean);

const briefFacts = [
  // À défaut de `targetAudience` (absent de la plupart des fiches), le badge du
  // hero dit déjà à qui le cours s'adresse.
  targetAudience?.[0]
    ? { label: 'Pour qui', text: targetAudience[0] }
    : (hero.badge ? { label: 'Niveau', text: hero.badge } : null),
  timeline[0]?.objective ? { label: 'Dès le premier module', text: timeline[0].objective } : null,
  courseDuration ? { label: 'Durée', text: `${courseDuration} de vidéo, en accès illimité` } : null,
  { label: 'Format', text: 'Vidéos en ligne, sans abonnement ni date de fin' },
].filter(Boolean) as Array<{ label: string; text: string }>;

// Faits chiffrés du hero : stats de la fiche + durée si elle est renseignée.
const heroFacts = [
  ...hero.stats.map(stat => ({ icon: stat.icon, value: stat.value, label: stat.label })),
  ...(courseDuration ? [{ icon: '⏰', value: courseDuration, label: 'de contenu' }] : []),
];
---

<!-- Schema.org Review pour les témoignages -->
{reviewSchemas.map(schema => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Schema.org FAQPage pour les questions du cours -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- Schema.org Offer pour le cours -->
<script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />

<CourseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  theme={theme}
  hero={hero}
  teachers={teachers}
  datePublished={course.data.datePublished}
  dateModified={course.data.dateModified}
  educationalLevel={course.data.educationalLevel}
  courseMode={course.data.courseMode}
  hasCourseInstance={course.data.hasCourseInstance}
  ratingValue={ratingValue}
  reviewCount={reviewCount}
  syllabusSections={syllabusSections}
  isoDuration={isoDuration}
>
  <BreadcrumbNav
    items={[
      { name: "Accueil", url: "/" },
      { name: "Cours", url: "/cours/" },
      { name: title, url: Astro.url.pathname }
    ]}
  />

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <span class="hero-badge">
          <Icon name="check" size={15} />
          {hero.badge}
        </span>
        <h1>{hero.title}</h1>
        <p class="hero-subtitle">{hero.subtitle}</p>

        <div class="cta-group">
          <a href={cta.buttonLink} class="btn-cta">
            <span class="btn-cta-label">{hero.cta.text}</span>
            {hero.cta.price && <span class="btn-cta-price">{hero.cta.price}</span>}
          </a>
          <span class="hero-guarantee">
            <Icon name="check-circle" size={18} />
            Satisfait ou remboursé 15 jours
          </span>
        </div>

        <dl class="hero-facts">
          {heroFacts.map(fact => {
            const iconName = emojiToIcon(fact.icon);
            return (
              <div class="hero-fact">
                <span class="hero-fact-icon" aria-hidden="true">
                  {iconName ? <Icon name={iconName} size={17} /> : fact.icon}
                </span>
                <div>
                  <dd>{fact.value}</dd>
                  <dt>{fact.label}</dt>
                </div>
              </div>
            );
          })}
        </dl>
      </div>

      <div class="hero-media">
        {/* Façade : l'image porte le LCP, l'iframe Vimeo n'est chargé qu'au clic
            (pas de connexion à un tiers avant une action de l'utilisateur). */}
        <div class="video-facade" data-video-id={hero.video.id} data-video-title={title}>
          <img
            src={heroImage}
            alt={`Aperçu de la formation ${title}`}
            width="640"
            height="360"
            fetchpriority="high"
            decoding="async"
          />
          <button type="button" class="video-play" aria-label={`Lire la vidéo de présentation : ${title}`}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- SECTION 1 bis : En bref (answer-first, cité par les moteurs de réponse) -->
  <section class="brief-section">
    <div class="container">
      <div class="brief">
        <h2 class="brief-title">En bref</h2>
        <p class="brief-text">{briefSentences.join(' ')}</p>
        <ul class="brief-facts">
          {briefFacts.map(fact => (
            <li>
              <Icon name="check" size={16} />
              <span><strong>{fact.label} :</strong>&#32;{fact.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- SECTION 2 : Pour qui (decision-first) -->
  <CourseTargetAudience items={targetAudience} theme={theme} />

  <!-- SECTION 3 : Frustrations (pain points) -->
  <section class="frustrations">
    <div class="container">
      <h2 class="frustrations-title">{frustrations.title}</h2>

      <div class="frustrations-grid">
        {frustrations.items.map(item => (
          <div class="frustration-card">
            <span class="frustration-icon"><ContentIcon icon={item.icon} size={22} /></span>
            <p class="frustration-text">{item.text}</p>
          </div>
        ))}
      </div>

      <div class="solution-banner">
        <p class="solution-text">{frustrations.solution}</p>
      </div>
    </div>
  </section>

  <!-- SECTION 4 : Valeur Unique -->
  <section class="valeur-unique">
    <div class="container">
      <div class="valeur-unique-content">
        <h2>{valeurUnique.title}</h2>
        <p class="description">{valeurUnique.description}</p>

        <div class="avantages-grid">
          {valeurUnique.avantages.map(avantage => (
            <div class="avantage-card">
              <span class="avantage-icon"><ContentIcon icon={avantage.icon} size={24} /></span>
              <p class="avantage-text">{avantage.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

<section class="timeline">
  <div class="container">
    <h2 class="timeline-title">Programme de la formation</h2>
    <div class="timeline-wrapper">
      {timeline.map((item) => {
        const timelineImagePath = imagePaths.timeline(item.number);
        // Toutes les fiches n'ont pas leurs visuels de programme : sans cette
        // vérification, la carte affichait un cadre vide et une requête 404.
        const hasImage = publicAssetExists(timelineImagePath);

        return (
          <div class="timeline-item" data-timeline-index={item.number}>
            <div class="timeline-number">{item.number}</div>
            <div class="timeline-content">
              <div class="timeline-header">
                <h3>{item.title}</h3>
                <p class="timeline-objective">{item.objective}</p>
              </div>
              <div class={`timeline-body${hasImage ? '' : ' timeline-body-no-image'}`}>
                {hasImage && (
                  <div class="timeline-image-wrapper">
                    <img
                      src={timelineImagePath}
                      alt={`${item.title} — ${item.objective}`}
                      class="timeline-image"
                      data-modal={`modal-${item.number}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <ul class="timeline-details">
                  {item.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        );
      })}
    </div>
    <div class="program-button-wrapper">
      <a href={`/cours/programme/${Astro.params.slug}/`} class="btn-program">
        Découvre le programme complet de la formation !
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

{hasDetailedProgram && (
  <section class="course-detail">
    <div class="container">
      <div class="course-detail-content">
        <Content />
      </div>
    </div>
  </section>
)}

<section class="mid-cta">
  <div class="container">
    <div class="mid-cta-content">
      <p class="mid-cta-text">Prêt à vous lancer ? Rejoignez les {preuveSociale.stats.students} élèves qui ont franchi le pas.</p>
      <a href={cta.buttonLink} class="btn-cta btn-cta-invert">
        <span class="btn-cta-label">{cta.buttonText}</span>
      </a>
      <span class="mid-cta-guarantee">
        <Icon name="check-circle" size={16} />
        Satisfait ou remboursé 15 jours
      </span>
    </div>
  </div>
</section>

<!-- Modals pour les images -->
{timeline.filter((item) => publicAssetExists(imagePaths.timeline(item.number))).map((item) => {
  const timelineImagePath = imagePaths.timeline(item.number);

  return (
    <div id={`modal-${item.number}`} class="modal">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <img 
          src={timelineImagePath} 
          alt={`${item.title} - Vue détaillée`}
          loading="lazy"
        />
      </div>
    </div>
  );
})}

<!-- SECTION 6 : Témoignage #1 (preuve sociale précoce) -->
{firstTestimonial && (
  <section class="testimonial-highlight">
    <div class="container">
      <div class="testimonial-highlight-card">
        <div class="quote-icon">&#10077;</div>
        <p class="testimonial-highlight-text">{firstTestimonial.text}</p>
        <div class="testimonial-highlight-author">
          <Avatar
            src={`/images/cours/${Astro.params.slug}/testimonial-1.webp`}
            name={firstTestimonial.author}
            size={56}
          />
          <span>{firstTestimonial.author}</span>
        </div>
      </div>
    </div>
  </section>
)}

<!-- SECTION 7 : Ce que vous obtenez -->
<CourseIncludes
  courseIncludes={courseIncludes}
  chapters={chaptersFromStats}
  duration={courseDuration}
  pricingFeatures={pricingFeatures}
/>

<!-- SECTION 8 : Prix + Garantie (composant dédié) -->
<CoursePricing
  title={pricing?.title || "Investissez dans votre passion"}
  price={course.data.hasCourseInstance?.offers?.price || "79"}
  currency={course.data.hasCourseInstance?.offers?.priceCurrency || "EUR"}
  installment={hero.cta.price}
  features={pricingFeatures}
  guarantee={pricing?.guarantee || "Garantie satisfait ou remboursé 15 jours"}
  ctaText={cta.buttonText}
  ctaLink={cta.buttonLink}
  accessLabel="Paiement unique · Accès à vie"
/>

<!-- SECTION 9 : Professeur -->
<section class="teachers-section">
  <div class="container">
    <div class="section-title-wrapper">
      <h2 class="teachers-title">
        {teachers.mainTeachers.length === 1 && (!teachers.guests || teachers.guests.length === 0) ?
          "Votre professeur" :
          "L'équipe pédagogique"
        }
      </h2>
    </div>

    <div class="main-teachers">
      {teachers.mainTeachers.map(teacher => (
        <div class="teacher-card">
          <div class="teacher-header">
            <div class="teacher-photo">
              <Avatar
                src={`/images/prof/${teacher.photo}`}
                name={`${teacher.firstName} ${teacher.lastName}`}
                size={88}
              />
            </div>
            <div class="teacher-identity">
              <h3>{teacher.firstName} <span class="last-name">{teacher.lastName}</span></h3>
              <p class="teacher-role">{teacher.subtitle}</p>
            </div>
          </div>
          <p class="teacher-description">{teacher.description}</p>
          {teacher.credentials && teacher.credentials.length > 0 && (
            <div class="teacher-credentials">
              {teacher.credentials.map(credential => (
                <span class="credential-badge">{credential}</span>
              ))}
            </div>
          )}
          {teacher.website && (
            <a href={teacher.website} class="teacher-website" target="_blank" rel="noopener noreferrer">
              Voir le site web &rarr;
            </a>
          )}
        </div>
      ))}
    </div>

    {teachers.guests && teachers.guests.length > 0 && (
      <div class="guest-teachers">
        <h3 class="guests-title">Professeurs invités</h3>
        <div class="guests-grid">
          {teachers.guests.map(guest => (
            <div class="guest-card">
              <div class="guest-photo">
                <Avatar src={`/images/prof/${guest.photo}`} name={guest.name} size={60} />
              </div>
              <h4>{guest.name}</h4>
              <p class="guest-role">{guest.subtitle}</p>
              {guest.website && (
                <a href={guest.website} class="guest-link" target="_blank" rel="noopener noreferrer">
                  En savoir plus &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<!-- SECTION 10 : Transformation Avant/Apres -->
{transformation && (
<section class="transformation-section">
  <div class="container">
    <h2 class="transformation-title">{transformation.title}</h2>
    <div class="transformation-grid">
      {transformation.items.map(item => (
        <div class="transformation-card">
          <div class="transformation-before">
            <span class="transformation-label transformation-label-before">Avant</span>
            <p>{item.before}</p>
          </div>
          <div class="transformation-arrow">
            <span class="arrow-desktop">&rarr;</span>
            <span class="arrow-mobile">&darr;</span>
          </div>
          <div class="transformation-after">
            <span class="transformation-label transformation-label-after">Après</span>
            <p>{item.after}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<!-- SECTION 11 : Témoignages restants + stats + partenaires -->
{remainingTestimonials.length > 0 && (
<section class="preuve-sociale">
  <div class="container">
    <div class="testimonials-wrapper" role="region" aria-label="Témoignages">
      {remainingTestimonials.map((testimonial, index) => {
        const testimonialImagePath = `/images/cours/${Astro.params.slug}/testimonial-${index + 2}.webp`;

        return (
          <div class="testimonial">
            <div class="quote-icon">&#10077;</div>
            <p class="testimonial-text">{testimonial.text}</p>
            <div class="testimonial-author">
              <Avatar src={testimonialImagePath} name={testimonial.author} size={50} />
              <span>{testimonial.author}</span>
            </div>
          </div>
        );
      })}
    </div>

    <div class="stats-banner">
      <div class="stat">
        <span class="stat-number">{preuveSociale.stats.students}</span>
        <span class="stat-label">élèves satisfaits</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-number">{preuveSociale.stats.successRate}</span>
        <span class="stat-label">{preuveSociale.stats.timeframe}</span>
      </div>
    </div>

    <div class="partners">
      <h3>Ils nous font confiance</h3>
