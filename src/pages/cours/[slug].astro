<script>
  // ------------------------------------------------------------------
  // Révélation progressive des blocs à l'entrée dans le viewport.
  //
  // Le masquage est posé par CSS, conditionné à la classe `js-reveal` que ce
  // script ajoute lui-même : si le JavaScript ne s'exécute pas, rien n'est
  // jamais masqué. Un filet de sécurité révèle tout au bout de 3 secondes,
  // pour qu'aucune section ne puisse rester vide.
  // ------------------------------------------------------------------
  (function () {
    const REVEAL_SELECTOR = [
      '.timeline-item',
      '.frustration-card',
      '.avantage-card',
      '.include-card',
      '.transformation-card',
      '.teacher-card',
      '.guest-card',
      '.testimonial',
      '.benefice-card',
      '.brief',
    ].join(',');

    const items = document.querySelectorAll(REVEAL_SELECTOR);
    if (!items.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion || !('IntersectionObserver' in window)) return;

    items.forEach(item => item.classList.add('reveal'));
    document.documentElement.classList.add('js-reveal');

    const revealAll = () => items.forEach(item => item.classList.add('is-visible'));
    const safety = window.setTimeout(revealAll, 3000);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;

        // Décalage léger entre voisins immédiats, plafonné pour qu'une longue
        // liste ne finisse pas par attendre une seconde entière.
        const parent = entry.target.parentElement;
        const siblings = parent ? Array.from(parent.children).filter(el => el.classList.contains('reveal')) : [];
        const delay = Math.min(siblings.indexOf(entry.target), 3) * 80;

        entry.target.style.transitionDelay = delay + 'ms';
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

    items.forEach(item => observer.observe(item));

    window.addEventListener('pagehide', () => window.clearTimeout(safety), { once: true });
  })();

  // ------------------------------------------------------------------
  // Façade vidéo : l'iframe Vimeo n'est inséré qu'au clic. Avant cela, la page
  // n'ouvre aucune connexion vers un tiers et le LCP porte sur l'image locale.
  // ------------------------------------------------------------------
  (function () {
    const facade = document.querySelector('.video-facade');
    if (!facade) return;

    const button = facade.querySelector('.video-play');
    if (!button) return;

    button.addEventListener('click', () => {
      const videoId = facade.getAttribute('data-video-id');
      const videoTitle = facade.getAttribute('data-video-title') || 'Vidéo de présentation';
      if (!videoId) return;

      const iframe = document.createElement('iframe');
      iframe.src = 'https://player.vimeo.com/video/' + encodeURIComponent(videoId) +
        '?title=0&byline=0&portrait=0&badge=0&autoplay=1';
      iframe.title = videoTitle;
      iframe.loading = 'lazy';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media';
      iframe.setAttribute('allowfullscreen', '');

      facade.replaceChildren(iframe);
      facade.classList.add('is-playing');
      iframe.focus();
    });
  })();
</script>
