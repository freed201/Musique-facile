---
/**
 * Outil « Quel accord de guitare apprendre ensuite ? »
 *
 * Le visiteur coche les accords qu'il connaît ; l'outil lui indique le seul
 * accord qui débloque le plus de morceaux du catalogue, le lui montre (schéma
 * + tutoriel vidéo), et liste ceux qu'il sait déjà jouer en entier.
 *
 * POURQUOI CETTE QUESTION, ET PAS « QUE PUIS-JE JOUER ? »
 * Mesuré sur le catalogue : avec les quatre accords que tout débutant apprend
 * en premier, AUCUN morceau n'est jouable intégralement à la guitare. Un outil
 * qui promet « voici ce que tu peux jouer » afficherait donc une page vide et
 * découragerait exactement celui qu'il devait aider. La question « que dois-je
 * apprendre maintenant ? » transforme cette rareté en prochaine étape concrète.
 * (À l'ukulélé, le calcul donne l'inverse — voir /outils/quel-accord-ukulele/.)
 *
 * Toute l'interface est dans OutilAccords.astro, partagée avec la version
 * ukulélé. Cette page ne porte que les données, les textes et le SEO.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FooterModern from '../../components/FooterModern.astro';
import BreadcrumbsSchema from '../../components/BreadcrumbsSchema.astro';
import OutilAccords from '../../components/outils/OutilAccords.astro';
import data from '../../data/song-chords.json';
import chordVideos from '../../data/chord-videos.json';
import { classerAccords, jouablesAvec, cleDiagramme } from '../../utils/outil-accords';
import diagrammesIndex from '../../data/chord-diagrams-index.json';

const canonicalURL = new URL('/outils/quel-accord-apprendre/', Astro.site || 'https://musique-facile.fr').toString();
const title = "Quel accord de guitare apprendre ensuite ? | Musique Facile";
const description =
  "Cochez les accords de guitare que vous connaissez : l'outil vous dit lequel apprendre ensuite et combien de morceaux il débloque, schéma et tutoriel à l'appui.";

/**
 * Seuls les morceaux relus entrent dans l'outil. « a-verifier » signale un
 * doute d'extraction non levé (voir scripts/extract-book-chords.mjs) : mieux
 * vaut un catalogue plus court qu'une réponse fausse sur un point que le
 * visiteur peut vérifier lui-même, guitare en main.
 */
const morceaux = (data.songs as any[])
  .filter((s) => s.statut !== 'a-verifier' && s.slug && s.accords?.length)
  .map((s) => ({
    titre: s.titre,
    artiste: s.artiste,
    accords: s.accords as string[],
    lien: `/blog/${s.slug}/`,
    tempo: s.tempo ?? null,
    difficulte: s.difficulte ?? null,
  }))
  .sort((a, b) => a.accords.length - b.accords.length || a.titre.localeCompare(b.titre, 'fr'));

/**
 * Tutoriels vidéo par accord (Shorts de la chaîne).
 *
 * La série est programmée jusqu'au 19 octobre 2026 : une vidéo n'est proposée
 * QUE si sa date de mise en ligne est passée, sinon le lien mènerait à une
 * vidéo indisponible. Même règle que pour la publication des articles. Le site
 * s'enrichit donc tout seul à mesure que la série sort, sans rien à modifier.
 */
const aujourdhui = new Date().toISOString().slice(0, 10);
const videosParAccord: Record<string, string> = {};
for (const v of chordVideos.videos) {
  if (v.instrument !== 'guitare') continue;
  if (v.datePublication > aujourdhui) continue;
  videosParAccord[v.accord] = v.youtubeId;
}

const guides = (chordVideos.guides as any[]).filter((g) => g.instrument === 'guitare');

const classement = classerAccords(morceaux);
const totalAccords = classement.length;
const diagrammes = (diagrammesIndex.diagrammes as Record<string, Record<string, string>>).guitare ?? {};
const nbSchemas = classement.filter(([a]) => diagrammes[cleDiagramme(a)]).length;
const nbVideos = Object.keys(videosParAccord).filter((a) => classement.some(([c]) => c === a)).length;

const breadcrumb = [
  { name: 'Accueil', url: 'https://musique-facile.fr/' },
  { name: 'Outils', url: 'https://musique-facile.fr/outils/quel-accord-apprendre/' },
];

/**
 * Déclaré comme WebApplication, et non comme article : c'est la seule chose
 * qui distingue cette page des cent articles du blog aux yeux d'un moteur ou
 * d'un LLM. Toutes les valeurs sont vraies et vérifiables sur la page — pas de
 * note ni d'avis, l'outil n'en a aucun.
 */
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Quel accord de guitare apprendre ensuite ?',
  url: canonicalURL,
  applicationCategory: 'EducationalApplication',
  browserRequirements: 'Fonctionne dans tout navigateur web récent.',
  operatingSystem: 'Tout',
  inLanguage: 'fr-FR',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description: `Outil gratuit : cochez les accords de guitare que vous savez poser, il calcule sur ${morceaux.length} morceaux relevés dans le livre de Fred Fieffé lequel apprendre ensuite, combien de morceaux il débloque, et ceux que vous savez déjà jouer en entier.`,
  featureList: [
    `Recommandation de l'accord qui débloque le plus de morceaux, sur un catalogue de ${morceaux.length} titres`,
    `Liste des morceaux jouables intégralement avec les accords déjà connus`,
    `Schéma de doigté pour ${nbSchemas} accords`,
    `Tutoriel vidéo pour ${nbVideos} accords`,
    'Filtre des morceaux jouables ou accessibles à un seul accord près',
  ],
  creator: { '@type': 'Person', name: 'Fred Fieffé', url: 'https://musique-facile.fr/a-propos/' },
  publisher: { '@type': 'Organization', name: 'Musique Facile', url: 'https://musique-facile.fr/' },
};

const faqs = [
  {
    question: "D'où viennent les accords de ces morceaux ?",
    answer: `Ils sont relevés un par un dans le livre de Fred Fieffé, page par page, et non estimés d'oreille ou repris d'une base tierce. ${morceaux.length} morceaux sont retenus : un relevé qui laisse un doute est écarté de l'outil plutôt que publié avec une approximation.`,
  },
  {
    question: 'Pourquoi si peu de morceaux jouables au début à la guitare ?',
    answer: `C'est mesuré sur le catalogue : avec les quatre premiers accords qu'apprend un débutant, aucun des ${morceaux.length} morceaux n'est jouable du début à la fin. Il en faut six pour en jouer ${jouablesAvec(morceaux, classement, 6)} intégralement, et dix pour en jouer ${jouablesAvec(morceaux, classement, 10)}. C'est justement pour ça que l'outil répond « quel accord apprendre ensuite » plutôt que « que peux-tu jouer ». À l'ukulélé, le même calcul donne l'inverse : quatre accords suffisent déjà pour plusieurs morceaux entiers.`,
  },
  {
    question: "Pourquoi certains accords n'ont-ils pas de schéma de doigté ?",
    answer: `Seules les positions du catalogue de doigtés sont affichées, soit ${nbSchemas} accords sur les ${totalAccords} du répertoire. Un accord dont la position varierait trop d'un arrangement à l'autre s'affiche sans schéma : un doigté inventé serait pire que pas de schéma du tout.`,
  },
];
---

<Layout title={title} description={description} canonicalUrl={canonicalURL}>
  <Fragment slot="head">
    <BreadcrumbsSchema items={breadcrumb} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </Fragment>

  <Header />

  <OutilAccords
    instrument="guitare"
    surtitre="Outil guitare"
    titre="Quel accord apprendre ensuite&nbsp;?"
    intro="Cochez les accords que vous savez déjà poser. L'outil vous indique celui qui débloque le plus de morceaux d'un coup, vous montre comment le poser, et liste ceux que vous pouvez déjà jouer en entier."
    morceaux={morceaux}
    videosParAccord={videosParAccord}
    ratioVideoAccord="9 / 16"
    guides={guides}
    titreGuides="Les 20 accords essentiels, en vidéo"
    introGuides="Si vous ne savez pas quoi cocher, commencez par là&nbsp;: le tutoriel complet des vingt accords qui portent l'essentiel du répertoire, puis le quiz pour vérifier que vous les tenez vraiment."
    origine={[
      "Les accords sont relevés dans le livre de Fred Fieffé, page par page, et non estimés. Un morceau dont le relevé laisse un doute est écarté de l'outil plutôt que d'être publié avec une approximation&nbsp;: vous pouvez vérifier chaque ligne, guitare en main.",
      "Les schémas de doigté reprennent les positions du livre pour les accords qui y figurent, et les positions standard pour les autres&nbsp;; un accord dont le doigté varierait trop d'un arrangement à l'autre s'affiche sans schéma plutôt qu'avec une position inventée.",
      "Le catalogue s'étoffe au fil des relectures et des nouveaux tutoriels. Vous jouez du ukulélé&nbsp;? <a href=\"/outils/quel-accord-ukulele-apprendre/\">Le même outil existe pour l'ukulélé</a>, et le calcul y est beaucoup plus encourageant.",
    ]}
    faqs={faqs}
  />

  <FooterModern />
</Layout>
