---
/**
 * home-v2.astro — maquette « Rentrée » de la nouvelle page d'accueil.
 *
 * URL : /home-v2/ — PAGE CACHÉE : noindex/nofollow, absente du sitemap,
 * Disallow dans public/robots.txt. La home actuelle (index.astro) n'est pas
 * touchée.
 *
 * PARTI PRIS
 * La page est un programme de rentrée. Le visiteur choisit son instrument
 * dans le premier écran (quatre boutons radio) et toute la page suit : la
 * couleur d'accent, l'instrument jouable, les chapitres, la capture d'écran,
 * la vidéo, le manifeste, l'ordre des avis, l'offre et son prix. Tout cela
 * sans JavaScript, avec le sélecteur CSS `:has()` ; sans lui, la guitare
 * s'affiche par défaut.
 *
 * Ce qui fait la différence : le premier écran ne montre pas le cours, il le
 * fait faire. L'accord de Do se gratte dans la page (FirstChord.astro),
 * do-mi-sol se joue, les premières notes se lisent. C'est la promesse du site
 * (« vous jouez dès la première leçon ») rendue vérifiable en dix secondes.
 *
 * Effets, tous en CSS et coupés sous `prefers-reduced-motion` : chapitres en
 * cartes qui s'empilent au défilement, manifeste révélé mot à mot. Aucun
 * dégradé, aucun compteur, aucun carrousel, aucune bibliothèque.
 *
 * L'offre affichée est celle que le site vend réellement (page /offre/) : le
 * Pack par instrument à 99 €, qui contient le cours débutant. Le cours seul
 * reste indiqué quand il coûte moins que le Pack.
 *
 * Typographie propre à cette maquette : Bricolage Grotesque (titres) et
 * Instrument Serif italique (les mots qui portent l'émotion), Inter en corps.
 * Palette : papier et encre, accent = couleur de l'instrument.
 *
 * Pour la promouvoir en home : reprendre ce fichier dans index.astro, passer
 * `robots` en « index, follow », retirer la ligne Disallow de robots.txt.
 */
import '@fontsource-variable/rubik/wght.css';
import '@fontsource-variable/rubik/wght-italic.css';
import '@fontsource-variable/shantell-sans/full.css';
import '../styles/experience-fonts.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FooterModern from '../components/FooterModern.astro';
import VideoFacade from '../components/home/VideoFacade.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import HomeSchemas from '../components/home/HomeSchemas.astro';
import FirstChord from '../components/home/FirstChord.astro';
import { paths, journey, screenCallouts, manifesto, reassurance, rentree, fred } from '../data/home-v2';
import { testimonials, formatTestimonialDate } from '../data/testimonials';
import { rating, reviews, students, videos, reviewsSource } from '../data/proof';

const canonicalURL = new URL(Astro.url.pathname, 'https://musique-facile.fr').toString();
const title = 'Cours de guitare, piano, ukulélé en ligne | Musique Facile';
const description =
  'Rentrée 2026 : apprenez la guitare, le piano, le ukulélé ou le solfège avec Fred Fieffé. Paiement unique, accès à vie, 15 jours remboursé. 4,7/5 sur 929 avis.';
const ogImage = 'https://musique-facile.fr/images/og-home.webp';

const LABELS = { guitar: 'Guitare', piano: 'Piano', ukulele: 'Ukulélé', solfege: 'Solfège' } as const;
/* Six avis sur sept : celui écarté est un fragment de trois mots. La note globale reste affichée avec sa source. */
const quotes = testimonials.filter((t) => t.id !== 'gaetane-c-2025-10');
const checkedOn = new Date(reviewsSource.checkedOn)
  .toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  .replace(/^1 /, '1er ');
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalUrl={canonicalURL}
  robots="noindex, nofollow"
>
  <Fragment slot="head">
    <meta name="author" content="Fred Fieffé - Musique Facile" />
    <HomeSchemas description={description} />
  </Fragment>

  <Header />

  <div class="hv xp">
    <!-- 1. Premier écran : promesse, choix de l'instrument, et l'instrument qui se joue -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__grid">
        <div class="hero__head">
          <p class="hero__kicker">
            <span class="hero__season">{rentree.season}</span>
            <span>École de musique en ligne, ambiance atelier, pas conservatoire</span>
          </p>
          <h1 id="hero-title">
            Vous rêvez de jouer depuis des années. <em>Cette rentrée, on s'y met.</em>
          </h1>
        </div>

        <div class="hero__copy">
          <p class="hero__lead">
            Fred Fieffé apprend aux adultes à jouer des morceaux, pas des gammes. Quinze minutes par jour, dans la bonne
            humeur. Un seul paiement, l'accès à vie.
            {paths.map((p) => (
              <span data-for={p.id}> {p.promise}</span>
            ))}
          </p>

          <fieldset class="pick">
            <legend>Je commence par</legend>
            <div class="pick__options">
              {paths.map((p, i) => (
                <label class={`pick__opt theme-${p.id}`}>
                  <input type="radio" name="instrument" id={`pick-${p.id}`} value={p.id} checked={i === 0} />
                  <span>{p.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="hero__visual">
          <FirstChord />
          {['guitar', 'ukulele'].map((id) => (
            <p class="stamp" data-for={id} aria-hidden="true">
              <span>Premier morceau</span>
              <span>avant la Toussaint</span>
              <span class="stamp__date">17 oct. 2026</span>
            </p>
          ))}
        </div>

        <div class="hero__cta">
          {paths.map((p) => (
            <p class="hero__offer" data-for={p.id}>
              {p.offer.includes.length > 1 ? (
                <>
                  <strong>{rentree.offerLabel}</strong> {p.offer.name} à {p.offer.price} : {p.offer.includes.length}{' '}
                  formations pour {p.offer.separately} prises séparément, jusqu'au {rentree.offerEndsShort}.{' '}
                  <a href="#offre">Le détail</a>
                </>
              ) : (
                <>
                  <strong>Le cours</strong> {p.offer.name}, {p.offer.price}. {p.offer.note} <a href="#offre">Le détail</a>
                </>
              )}
            </p>
          ))}
          <div class="hero__actions">
            {paths.map((p) => (
              <a data-for={p.id} href={p.offer.url} class="btn btn--primary">
                Commencer {p.object} · {p.offer.price}
              </a>
            ))}
            <a href="#parcours" class="btn btn--ghost">Voir les 30 premiers jours</a>
          </div>
          <p class="hero__terms">Paiement unique · accès à vie · 15 jours pour changer d'avis, un e-mail suffit</p>
          <p class="hero__proof">
            <strong>{rating.display}</strong> sur
            <a href={reviewsSource.url} rel="noopener nofollow" target="_blank">{reviews.display} avis vérifiés</a>
            · <strong>{students.display}</strong> élèves depuis 2015
          </p>
        </div>
      </div>
    </section>

    <!-- 1b. Barre collante : le choix reste sous les yeux, avec le prix -->
    <div class="bar" aria-label="Instrument choisi">
      <div class="container bar__inner">
        <span class="bar__label">Je commence par</span>
        <div class="bar__opts">
          {paths.map((p) => (
            <label for={`pick-${p.id}`} class={`bar__opt theme-${p.id}`} data-mirror={p.id}>{p.label}</label>
          ))}
        </div>
        {paths.map((p) => (
          <a data-for={p.id} href={p.offer.url} class="bar__cta">Commencer {p.object} · {p.offer.price}</a>
        ))}
      </div>
    </div>

    <!-- 2. Le programme : quatre chapitres en cartes qui s'empilent -->
    <section class="journey" id="parcours" aria-labelledby="journey-title">
      <div class="container journey__head">
        <p class="eyebrow">Vos 30 premiers jours</p>
        <h2 id="journey-title">Un mois pour <em>y prendre goût</em>, chapitre par chapitre</h2>
        <p class="journey__lead">
          À quinze minutes par jour, dans l'ordre du cours.
          {paths.map((p) => (
            <span data-for={p.id}>
              {' '}{p.lessons}, {p.duration}, le même prof du premier au dernier chapitre.
            </span>
          ))}
        </p>
      </div>

      <ol class="stack" role="list">
        {journey.map((step, i) => (
          <li class="jcard" style={`--i: ${i}`}>
            <div class="container">
              <div class="jcard__inner">
                <div class="jcard__copy">
                  <p class="jcard__marker">
                    <span class="jcard__num">{step.number}</span>
                    <span class="jcard__when">{step.marker}</span>
                  </p>
                  {paths.map((p) => {
                    const v = step.byInstrument[p.id];
                    return (
                      <div data-for={p.id} class="jcard__var">
                        <h3>{v.title}</h3>
                        <ul>
                          {v.details.map((d) => <li>{d}</li>)}
                        </ul>
                      </div>
                    );
                  })}
                </div>
                <div class="jcard__media">
                  {paths.map((p) => {
                    const v = step.byInstrument[p.id];
                    return (
                      <img data-for={p.id} src={v.image} alt={v.imageAlt} width="1824" height="1042" loading="lazy" decoding="async" />
                    );
                  })}
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <p class="container journey__note">
        Repères indicatifs à quinze minutes par jour ; le rythme est le vôtre, l'accès n'expire pas.
      </p>
    </section>

    <!-- 3. Ce que vous voyez à l'écran : la capture réelle, annotée, et la vidéo de présentation -->
    <section class="ecran" id="ecran" aria-labelledby="ecran-title">
      <div class="container ecran__head">
        <p class="eyebrow">Dans la classe</p>
        <h2 id="ecran-title">Ce que vous voyez <em>à l'écran</em></h2>
      </div>
      <div class="container ecran__grid">
        {paths.map((p) => (
          <figure class="shot" data-for={p.id}>
            <div class="shot__frame">
              <img src={p.image} alt={p.imageAlt} width="1824" height="1042" loading="lazy" decoding="async" />
              {screenCallouts[p.id].map((c, i) => (
                <span class="shot__pin" style={`--x: ${c.x}%; --y: ${c.y}%`} data-pin={i + 1} aria-hidden="true">
                  {i + 1}
                </span>
              ))}
            </div>
            <figcaption>Extrait réel · {p.courseName}</figcaption>
          </figure>
        ))}
        <div class="ecran__side">
          {paths.map((p) => (
            <ol class="pins" data-for={p.id}>
              {screenCallouts[p.id].map((c, i) => (
                <li>
                  <span class="pins__n">{i + 1}</span>
                  <div>
                    <h3>{c.title}</h3>
                    <p>{c.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          ))}
          {paths.map((p) => (
            <div data-for={p.id} class="ecran__video">
              <VideoFacade
                videoId={p.videoId}
                poster={journey[1].byInstrument[p.id].image}
                title={`Fred Fieffé présente ${p.courseName}`}
                caption="La vidéo de présentation, la même que sur la fiche cours. Rien ne se charge avant votre clic."
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. L'offre de rentrée : le Pack de l'instrument choisi, et rien d'autre -->
    <section class="price" id="offre" aria-labelledby="price-title">
      <div class="container">
        <p class="eyebrow">
          {paths.map((p) => (
            <span data-for={p.id}>
              {p.offer.includes.length > 1 ? `${rentree.offerLabel} · jusqu'au ${rentree.offerEndsLabel}` : 'Ce que ça coûte'}
            </span>
          ))}
        </p>
        <h2 id="price-title">
          {paths.map((p) => (
            <span data-for={p.id}>{p.offer.price}, une fois. <em>Pas tous les mois.</em></span>
          ))}
        </h2>

        {paths.map((p) => (
          <div class="offer" data-for={p.id}>
            <div class="offer__main">
              <p class="offer__name">{p.offer.name}</p>
              <p class="offer__price">
                <strong>{p.offer.price}</strong>
                {p.offer.separately ? (
                  <span>
                    pour {p.offer.separately} de formations prises séparément<sup><a href="#note-6" aria-label="Note 6">6</a></sup>
                  </span>
                ) : (
                  <span>en une fois, accès à vie</span>
                )}
              </p>
              <a href={p.offer.url} class="btn btn--primary btn--lg">Commencer {p.object} · {p.offer.price}</a>
              <p class="offer__terms">
                Paiement unique · accès à vie · 15 jours pour changer d'avis
                {p.offer.includes.length > 1 && <> · offre valable jusqu'au {rentree.offerEndsLabel}</>}
              </p>
              {p.priceValue < p.offer.priceValue && (
                <p class="offer__alt">
                  Le cours débutant seul, {p.courseName} : {p.price}, {p.installments}.
                  <a href={p.courseUrl}>Voir la fiche du cours</a>.
                </p>
              )}
              {p.offer.note && <p class="offer__alt">{p.offer.note}</p>}
            </div>
            <div class="offer__detail">
              <p class="offer__caption">
                {p.offer.includes.length > 1 ? 'Ce que contient le Pack' : 'Ce que contient le cours'}
              </p>
              <ul class="offer__list" role="list">
                {p.offer.includes.map((item) => (
                  <li>
                    <span>{item.title}</span>
                    {p.offer.includes.length > 1 && <span class="offer__each">{item.price} seul</span>}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}

        <ul class="assure" role="list">
          {reassurance.map((r, i) => (
            <li>
              <span>{r.label}</span>
              <sup><a href={`#note-${i + 1}`} aria-label={`Note ${i + 1}`}>{i + 1}</a></sup>
            </li>
          ))}
        </ul>

        <p class="price__guarantee">
          <strong>Quinze jours pour changer d'avis.</strong> Vous achetez, vous suivez les leçons. Si ça ne vous
          convient pas, un message depuis <a href="/contact/">la page contact</a> suffit : vous êtes remboursé. Ensuite,
          l'accès reste ouvert à vie, mises à jour comprises.
        </p>
      </div>
    </section>

    <!-- 5. Manifeste, révélé mot à mot -->
    <section class="manifesto" aria-label="Ce qu'il faut pour apprendre">
      <div class="container">
        {paths.map((p) => (
          <p class="manifesto__text" data-for={p.id}>
            {manifesto[p.id].split(' ').map((w) => (
              <span class="w">{w}</span>
            ))}
          </p>
        ))}
      </div>
    </section>

    <!-- 6. Le public : la note et sa source, les avis mot pour mot, une vraie photo -->
    <section class="public" aria-labelledby="public-title">
      <div class="container public__grid">
        <div class="public__copy">
          <p class="eyebrow">Ils s'y sont mis</p>
          <h2 id="public-title">Des adultes qui ont commencé <em>exactement là où vous êtes</em></h2>
          <p class="public__rating">
            <strong>{rating.display}</strong> sur
            <a href={reviewsSource.url} rel="noopener nofollow" target="_blank">{reviews.display} avis Skilleos</a>,
            relevé le {checkedOn}. Les avis ci-contre sont recopiés mot pour mot ; ceux de votre instrument viennent en
            premier.
          </p>
          <figure class="ph taped">
            <img
              src="/images/stage-ukulele-juillet-2026-fun.webp"
              width="1280"
              height="720"
              alt="Six élèves adultes d'un stage de ukulélé, instruments levés, devant un mur de lierre"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Stage de ukulélé, juillet 2026, à Grasse. Personne ne savait jouer trois jours plus tôt.</figcaption>
          </figure>
        </div>
        <ul class="quotes" role="list">
          {quotes.map((t) => (
            <li class={`quote theme-${t.instrument}`} data-q={t.instrument}>
              <blockquote cite={t.sourceUrl}>
                <p>« {t.quote} »</p>
                <footer>
                  <strong>{t.name}</strong> · {LABELS[t.instrument]} · {formatTestimonialDate(t.date, t.datePrecision)}
                  {t.sourceUrl && (
                    <> · <a href={t.sourceUrl} rel="noopener nofollow" target="_blank">{t.sourceName}</a></>
                  )}
                </footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Le prof -->
    <section class="prof" aria-labelledby="prof-title">
      <div class="container prof__grid">
        <figure class="prof__visual taped">
          <img
            src={fred.photo}
            alt="Fred Fieffé, souriant, un ukulélé à la main, devant un feuillage"
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Fred Fieffé</figcaption>
        </figure>
        <div class="prof__copy">
          <p class="eyebrow">Votre prof</p>
          <h2 id="prof-title">Je m'appelle Fred. <em>Je serai votre seul prof.</em></h2>
          <p>
            Je joue depuis plus de quarante ans et j'enseigne en ligne depuis 2015. J'ai commencé par la guitare,
            puis le piano, le ukulélé, et j'ai fini par écrire des méthodes pour Hal Leonard. Ce que j'ai appris en
            {students.display} élèves tient en une phrase : un adulte qui débute n'a pas besoin de théorie, il a besoin
            de jouer quelque chose dès la première semaine.
          </p>
          <p>
            Toutes mes formations sont construites comme ça. Sur les quatre parcours débutant, c'est ma voix sur
            chaque leçon, du premier accord au dernier morceau, sur {videos.display} vidéos.
          </p>
          <ul class="prof__creds" role="list">
            {fred.credentials.map((c) => <li>{c}</li>)}
          </ul>
          <p class="prof__links">
            <a href={fred.aboutUrl}>Mon parcours en détail</a>
            <a href={fred.authorUrl}>Mes articles</a>
          </p>
        </div>
      </div>
    </section>

    <!-- 8. FAQ -->
    <HomeFaq heading="Les questions qu'on me pose avant d'acheter" />

    <!-- 9. Dernier appel, avec le calendrier réel -->
    <section class="final" aria-labelledby="final-title">
      <div class="container final__grid">
        <div>
          <p class="eyebrow">{rentree.season}</p>
          <h2 id="final-title">
            <span data-for="guitar">{rentree.claim}<em>.</em></span>
            <span data-for="ukulele">{rentree.claim}<em>.</em></span>
            <span data-for="piano">Cette rentrée, vous jouez <em>dès la première leçon.</em></span>
            <span data-for="solfege">Cette rentrée, vous apprenez <em>à lire la musique.</em></span>
          </h2>
          {paths.map((p) => (
            <a data-for={p.id} href={p.offer.url} class="btn btn--primary btn--lg">
              Commencer {p.object} · {p.offer.price}
            </a>
          ))}
          <p class="final__terms">
            {paths.map((p) => (
              <span data-for={p.id}>
                {p.offer.includes.length > 1
                  ? `${rentree.offerLabel} jusqu'au ${rentree.offerEndsLabel} · paiement unique · accès à vie · 15 jours pour changer d'avis`
                  : 'Paiement unique · accès à vie · 15 jours pour changer d’avis'}
              </span>
            ))}
          </p>
        </div>
        <ol class="cal" aria-label="Repères du programme">
          <li>
            <span class="cal__k">Aujourd'hui</span>
            <span>Leçon 1, quinze minutes. Vous avez déjà joué votre premier accord plus haut.</span>
          </li>
          <li>
            <span class="cal__k">Jour 30</span>
            {paths.map((p) => (
              <span data-for={p.id}>{p.promise}</span>
            ))}
          </li>
          <li>
            <span class="cal__k">{rentree.toussaintLabel}</span>
            <span>
              Début des vacances de la Toussaint<sup><a href="#note-5" aria-label="Note 5">5</a></sup>
            </span>
          </li>
        </ol>
      </div>
    </section>

    <!-- 10. Notes -->
    <section class="notes" aria-label="Notes et sources">
      <div class="container">
        <ol>
          {reassurance.map((r, i) => (
            <li id={`note-${i + 1}`}>
              {r.note} <a href={r.href}>Voir {r.linkLabel}</a>.
            </li>
          ))}
          <li id="note-5">{rentree.source} Vacances de la Toussaint {rentree.toussaintRange}, toutes zones.</li>
          <li id="note-6">
            Somme des prix de chaque formation prise seule, tels qu'affichés sur leurs fiches cours le 4 septembre 2026.
            Ce n'est pas un ancien prix du Pack. <a href="/cours/">Voir les fiches cours</a>.
          </li>
        </ol>
      </div>
    </section>

    <!-- Sur téléphone : le bouton suit, avec le prix de l'instrument choisi -->
    <div class="mcta" data-mcta>
      {paths.map((p) => (
        <a data-for={p.id} href={p.offer.url} class="mcta__btn">
          Commencer {p.object} · {p.offer.price}
        </a>
      ))}
    </div>
  </div>

  <FooterModern />
</Layout>

<style>
  /* =========================================================
     Palette et typographie propres à la maquette.
     Si elle est retenue, ces tokens montent dans design-tokens.css.
     ========================================================= */
  .hv {
    --hv-header: 80px;
    --bar-h: 48px;
    --hv-chrome: calc(var(--hv-header) + var(--bar-h));
    --hv-display: var(--xp-display);
    --hv-serif: var(--xp-display);

    --hv-paper: #f6f0e4;
    --hv-paper-2: #ede4d3;
    --hv-card: #fffaf0;
    --hv-ink: #23193d;
    --hv-ink-2: #5a4f75;
    --hv-line: rgba(35, 25, 61, 0.16);
    --hv-hand: var(--xp-voice);

    /* Le jaune soleil : bouton, points de doigté, autocollants. */
    --hv-sun: #ffcf5a;
    --hv-sun-ink: #3a2a00;

    /* La scène : la couleur pleine de l'instrument, sur le premier et le dernier écran. */
    --hv-stage: var(--brand-500);

    /* Accent = instrument choisi ; violet de marque par défaut. */
    --hv-accent: var(--brand-500);
    --hv-accent-ink: var(--brand-600);
    --hv-accent-soft: color-mix(in srgb, var(--hv-accent) 12%, var(--hv-paper));
    --hv-accent-line: color-mix(in srgb, var(--hv-accent) 40%, var(--hv-paper));

    /* La home reste claire quel que soit le réglage du navigateur : le papier
       et l'encre sont le design. Les tokens globaux (utilisés par la FAQ et les
       composants partagés) sont réalignés pour ne pas basculer en sombre. */
    color-scheme: light;
    --bg-page: var(--hv-paper);
    --bg-alt: var(--hv-paper-2);
    --bg-card: var(--hv-card);
    --bg-elevated: var(--hv-card);
    --text-primary: var(--hv-ink);
    --text-secondary: var(--hv-ink-2);
    --text-muted: var(--hv-ink-2);
    --border-default: var(--hv-line);
    --surface-white: var(--hv-card);
    --surface-light: var(--hv-paper);

    background: var(--hv-paper);
    color: var(--hv-ink);
    font-family: var(--xp-text);
  }

  .hv .stamp, .hv .jcard__when, .hv :global(.fc__hand) {
    font-variation-settings: var(--xp-voice-settings);
  }

  @media (max-width: 768px) {
    .hv {
      --hv-header: 70px;
    }
  }

  /* L'accent suit l'instrument coché. Sans :has(), le violet reste. */
  .hv:has(#pick-guitar:checked) { --hv-accent: var(--guitar-600); --hv-accent-ink: var(--guitar-800); --hv-accent-line: var(--guitar-400); --hv-stage: #2e7d32; }
  .hv:has(#pick-piano:checked) { --hv-accent: var(--piano-500); --hv-accent-ink: var(--piano-800); --hv-accent-line: #7fc4cc; --hv-stage: #2f6a70; }
  .hv:has(#pick-ukulele:checked) { --hv-accent: var(--ukulele-800); --hv-accent-ink: var(--ukulele-950); --hv-accent-line: var(--ukulele-500); --hv-stage: #d14d00; }
  .hv:has(#pick-solfege:checked) { --hv-accent: var(--solfege-700); --hv-accent-ink: var(--solfege-900); --hv-accent-line: #ff8a80; --hv-stage: #b3261e; }

  /* Les variantes par instrument : tout est dans le HTML, une seule visible. */
  /* `:global()` : les variantes rendues par un composant enfant (FirstChord)
     ne portent pas l'attribut de portée de cette page, elles doivent être
     visées aussi. */
  .hv:has(#pick-guitar:checked) :global([data-for]:not([data-for='guitar'])),
  .hv:has(#pick-piano:checked) :global([data-for]:not([data-for='piano'])),
  .hv:has(#pick-ukulele:checked) :global([data-for]:not([data-for='ukulele'])),
  .hv:has(#pick-solfege:checked) :global([data-for]:not([data-for='solfege'])) {
    display: none !important;
  }

  @supports not selector(:has(*)) {
    .hv :global([data-for]:not([data-for='guitar'])) {
      display: none !important;
    }
  }

  .hv [id] {
    scroll-margin-top: calc(var(--hv-chrome) + var(--space-4));
  }

  /* ---------- typographie commune ---------- */
  .hv h1,
  .hv h2,
  .hv h3 {
    font-family: var(--hv-display);
    font-variation-settings: var(--xp-display-settings);
    color: var(--hv-ink);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hv h1 em,
  .hv h2 em {
    font-family: var(--hv-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--hv-accent-ink);
    letter-spacing: 0;
  }

  .hv p {
    text-wrap: pretty;
  }

  .eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hv-accent-ink);
  }

  .hv a:not(.btn, .bar__cta, .mcta__btn) {
    color: inherit;
  }

  /* La FAQ partagée prend la typographie de la maquette. */
  .hv :global(.hfaq__head h2),
  .hv :global(.hfaq summary) {
    font-family: var(--hv-display);
    letter-spacing: -0.02em;
  }

  .hv :global(.hfaq) {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  /* ---------- boutons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    font-family: var(--hv-display);
    font-weight: 600;
    font-size: var(--text-base);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .btn--primary {
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
    box-shadow: 0 6px 0 -2px rgba(35, 25, 61, 0.18);
  }

  .btn--primary:hover {
    background: var(--hv-ink);
    color: var(--hv-paper);
    transform: translateY(-2px);
  }

  .btn--ghost {
    color: var(--hv-ink);
    border: 1px solid var(--hv-line);
    background: transparent;
  }

  .btn--ghost:hover {
    background: var(--hv-paper-2);
  }

  .btn--lg {
    padding: var(--space-5) var(--space-8);
    font-size: var(--text-lg);
  }

  .btn:focus-visible {
    outline: 3px solid var(--hv-accent);
    outline-offset: 3px;
  }

  /* =========================================================
     1. Hero
     ========================================================= */
  .hero {
    padding: calc(var(--hv-header) + var(--space-8)) 0 var(--space-10);
    background: var(--hv-stage);
    color: var(--hv-paper);
    transition: background-color 0.5s var(--ease-out);
  }

  .hero h1,
  .hero .pick legend,
  .hero__proof strong {
    color: var(--hv-paper);
  }

  /* Le mot qui compte, souligné à la main. */
  .hero h1 em {
    color: var(--hv-sun);
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 14' preserveAspectRatio='none'><path d='M3 9 C 40 3, 70 12, 110 6 S 170 4, 197 8' fill='none' stroke='%23ffcf5a' stroke-width='3.5' stroke-linecap='round'/></svg>") no-repeat left 100% / 100% 0.32em;
    padding-bottom: 0.08em;
  }

  .hero .hero__kicker,
  .hero .hero__lead,
  .hero .hero__terms,
  .hero .hero__proof {
    color: rgba(246, 240, 228, 0.86);
  }

  .hero .hero__season {
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
    transform: rotate(-2deg);
  }

  .hero .pick__opt span {
    background: transparent;
    border-color: rgba(246, 240, 228, 0.45);
    color: var(--hv-paper);
  }

  .hero .pick__opt span:hover {
    transform: translateY(-2px);
  }

  .hero .pick__opt input:checked + span {
    background: var(--hv-sun);
    border-color: var(--hv-sun);
    color: var(--hv-sun-ink);
    animation: pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }

  @keyframes pop {
    0% { transform: scale(0.92); }
    60% { transform: scale(1.06); }
    100% { transform: scale(1); }
  }

  .hero .btn--ghost {
    color: var(--hv-paper);
    border-color: rgba(246, 240, 228, 0.45);
  }

  .hero .btn--ghost:hover {
    background: rgba(246, 240, 228, 0.12);
  }

  .hero__offer {
    background: rgba(246, 240, 228, 0.12);
    border-color: rgba(246, 240, 228, 0.28);
    color: var(--hv-paper);
  }

  .hero__offer strong {
    color: var(--hv-sun);
  }

  .hero__offer strong::after {
    color: rgba(246, 240, 228, 0.6);
  }

  /* L'instrument prend les couleurs du fond sombre. */
  .hero__visual :global(.fc) {
    --fc-ink: var(--hv-paper);
    --fc-muted: rgba(246, 240, 228, 0.78);
    --fc-line: rgba(246, 240, 228, 0.3);
    --fc-accent: var(--hv-sun);
    --fc-accent-ink: var(--hv-sun-ink);
    --fc-glow: #fff1b8;
    --fc-white: #fffaf0;
    --fc-black: var(--hv-ink);
    --fc-paper: var(--hv-stage);
    --fc-hand: var(--hv-hand);
  }

  .hero__visual :global(.fc__play) {
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  /* Téléphone : titre, instrument, puis le choix et le bouton. */
  .hero__head { order: 1; }
  .hero__visual { order: 2; }
  .hero__copy { order: 3; }
  .hero__cta { order: 4; }

  .hero h1 {
    margin-bottom: 0;
  }

  .hero__copy .pick {
    margin-bottom: 0;
  }

  .hero__kicker {
    margin: 0 0 var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--hv-ink-2);
  }

  .hero__season {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--brand-500);
    color: #fff;
    font-family: var(--hv-display);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 4.6vw, 4rem);
    line-height: 1.02;
    margin: 0 0 var(--space-5);
    font-weight: 700;
  }

  .hero__lead {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--hv-ink-2);
    max-width: 56ch;
    margin: 0 0 var(--space-6);
  }

  /* Sélecteur d'instrument */
  .pick {
    border: 0;
    margin: 0 0 var(--space-6);
    padding: 0;
    min-width: 0;
  }

  .pick legend {
    font-family: var(--hv-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--hv-ink);
    padding: 0;
    margin-bottom: var(--space-2);
  }

  .pick__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pick__opt {
    position: relative;
    cursor: pointer;
  }

  .pick__opt input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .pick__opt span {
    display: inline-block;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    border: 1.5px solid var(--hv-line);
    background: var(--hv-card);
    font-family: var(--hv-display);
    font-weight: 600;
    color: var(--hv-ink);
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .pick__opt input:checked + span {
    background: var(--theme-surface, var(--brand-500));
    border-color: var(--theme-surface, var(--brand-500));
    color: #fff;
  }

  .pick__opt input:focus-visible + span {
    outline: 3px solid var(--theme-current);
    outline-offset: 3px;
  }

  .hero__offer {
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--hv-accent-soft);
    border: 1px solid var(--hv-accent-line);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--hv-ink);
    max-width: 56ch;
  }

  .hero__offer strong {
    font-family: var(--hv-display);
    font-weight: 700;
    color: var(--hv-accent-ink);
  }

  .hero__offer strong::after {
    content: ' · ';
    color: var(--hv-ink-2);
    font-weight: 400;
  }

  .hero__offer a {
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .hero__terms {
    margin: 0 0 var(--space-5);
    font-size: var(--text-sm);
    color: var(--hv-ink-2);
  }

  .hero__proof {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--hv-ink-2);
  }

  .hero__proof strong {
    color: var(--hv-ink);
    font-family: var(--hv-display);
    font-variant-numeric: tabular-nums;
  }

  .hero__proof a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__visual {
    position: relative;
  }

  /* Le tampon « rentrée » */
  .stamp {
    display: none;
    position: absolute;
    top: 8px;
    right: 0;
    width: 128px;
    height: 128px;
    margin: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border: 2px solid var(--hv-sun-ink);
    border-radius: var(--radius-full);
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
    font-family: var(--hv-hand);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.1;
    transform: rotate(-10deg);
    box-shadow: 0 0 0 5px var(--hv-stage);
    z-index: 1;
  }

  .stamp__date {
    margin-top: var(--space-2);
    font-family: var(--hv-display);
    font-style: normal;
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* =========================================================
     1b. Barre collante
     ========================================================= */
  .bar {
    position: sticky;
    top: var(--hv-header);
    z-index: var(--z-sticky);
    height: var(--bar-h);
    background: var(--hv-paper);
    border-bottom: 1px solid var(--hv-line);
  }

  .bar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .bar__label {
    display: none;
    font-family: var(--hv-display);
    font-weight: 600;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .bar__opts {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
  }

  .bar__opts::-webkit-scrollbar {
    display: none;
  }

  .bar__opt {
    padding: 6px var(--space-3);
    border-radius: var(--radius-full);
    font-family: var(--hv-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--hv-ink-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .bar__opt:hover {
    color: var(--hv-ink);
  }

  .hv:has(#pick-guitar:checked) [data-mirror='guitar'],
  .hv:has(#pick-piano:checked) [data-mirror='piano'],
  .hv:has(#pick-ukulele:checked) [data-mirror='ukulele'],
  .hv:has(#pick-solfege:checked) [data-mirror='solfege'] {
    background: var(--theme-surface, var(--brand-500));
    color: #fff;
  }

  .bar__cta {
    display: none;
    padding: 6px var(--space-4);
    border-radius: var(--radius-md);
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
    font-family: var(--hv-display);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .bar__cta:hover {
    background: var(--hv-ink);
    color: var(--hv-paper);
  }

  .bar__cta:focus-visible {
    outline: 3px solid var(--hv-accent);
    outline-offset: 2px;
  }

  /* =========================================================
     2. Le programme : cartes collantes, compactes
     ========================================================= */
  .journey {
    padding: var(--space-16) 0 var(--space-6);
  }

  .journey__head {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .journey h2 {
    font-size: var(--text-responsive-3xl);
    line-height: 1.02;
    margin: 0 0 var(--space-4);
    font-weight: 700;
  }

  .journey__lead {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--hv-ink-2);
  }

  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .jcard {
    position: sticky;
    top: calc(var(--hv-chrome) + var(--space-3) + var(--i) * 10px);
    margin-bottom: var(--space-4);
  }

  .jcard__inner {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
    border-radius: var(--radius-2xl);
    background: var(--hv-card);
    border: 1px solid var(--hv-line);
    box-shadow: 0 -12px 40px -24px rgba(27, 21, 51, 0.35);
  }

  .jcard__marker {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
  }

  .jcard__num {
    font-family: var(--hv-serif);
    font-style: italic;
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 0.9;
    color: var(--hv-accent-ink);
  }

  .jcard__when {
    font-family: var(--hv-hand);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: 1;
    padding: 4px 10px;
    border-radius: 3px;
    background: var(--hv-sun);
    color: var(--hv-sun-ink);
    transform: rotate(-3deg);
  }

  .jcard__var h3 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
    font-weight: 700;
  }

  .jcard__var ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-base);
    color: var(--hv-ink-2);
  }

  .jcard__var li {
    padding-left: var(--space-5);
    position: relative;
  }

  .jcard__var li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 9px;
    height: 9px;
    border-radius: var(--radius-full);
    background: var(--hv-accent);
  }

  .jcard__media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--gray-900);
    align-self: center;
  }

  .jcard__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .journey__note {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--hv-ink-2);
  }

  /* =========================================================
     3. À l'écran : capture annotée + vidéo
     ========================================================= */
  .ecran {
    padding: var(--space-16) 0;
    background: var(--hv-ink);
    color: var(--hv-paper);
  }

  .ecran__head {
    margin-bottom: var(--space-8);
  }

  .ecran h2 {
    color: var(--hv-paper);
    font-size: var(--text-responsive-2xl);
    margin: 0;
    font-weight: 700;
  }

  .ecran h2 em,
  .ecran .eyebrow {
    color: var(--hv-accent-line);
  }

  .ecran__grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .shot {
    margin: 0;
  }

  .shot__frame {
    position: relative;
    aspect-ratio: 1824 / 1042;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .shot__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot__pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 34px;
    height: 34px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--hv-accent);
    color: #fff;
    font-family: var(--hv-display);
    font-weight: 700;
    font-size: var(--text-sm);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.35), 0 8px 20px -6px rgba(0, 0, 0, 0.7);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .ecran:has(.pins li:nth-child(1):hover) .shot__pin[data-pin='1'],
  .ecran:has(.pins li:nth-child(2):hover) .shot__pin[data-pin='2'],
  .ecran:has(.pins li:nth-child(3):hover) .shot__pin[data-pin='3'] {
    transform: translate(-50%, -50%) scale(1.25);
  }

  .shot figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.65);
  }

  .ecran__side {
    display: grid;
    gap: var(--space-8);
  }

  .pins {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .pins li {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-3);
    margin: calc(-1 * var(--space-3));
    border-radius: var(--radius-lg);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .pins li:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .pins__n {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--hv-accent);
    color: #fff;
    font-family: var(--hv-display);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .pins h3 {
