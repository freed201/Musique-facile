<script>
  // Barre collante : cocher le bouton radio sans lui donner le focus, sinon le
  // navigateur ramène la page en haut, sur le sélecteur du hero.
  document.querySelectorAll<HTMLLabelElement>('.bar__opt').forEach((label) => {
    label.addEventListener('click', (event) => {
      event.preventDefault();
      const input = document.getElementById(label.htmlFor) as HTMLInputElement | null;
      if (input) input.checked = true;
    });
  });

  // Barre collante sur téléphone : cachée en descendant, de retour en remontant.
  const bar = document.querySelector<HTMLElement>('.bar');
  const narrow = window.matchMedia('(max-width: 899px)');
  let lastY = window.scrollY;
  window.addEventListener(
    'scroll',
    () => {
      if (!bar || !narrow.matches) return;
      const y = window.scrollY;
      const down = y > lastY + 6;
      const up = y < lastY - 6;
      if (down && y > 400) bar.classList.add('is-hidden');
      else if (up) bar.classList.remove('is-hidden');
      if (down || up) lastY = y;
    },
    { passive: true },
  );

  // Bouton mobile : visible une fois le premier écran passé, caché devant le
  // dernier appel (qui a déjà le sien) et le pied de page.
  const mcta = document.querySelector<HTMLElement>('[data-mcta]');
  const hero = document.querySelector('.hero');
  const final = document.querySelector('.final');
  if (mcta && hero && final && 'IntersectionObserver' in window) {
    let pastHero = false;
    let onFinal = false;
    const update = () => mcta.classList.toggle('is-visible', pastHero && !onFinal);
    new IntersectionObserver(
      ([e]) => {
        pastHero = !e.isIntersecting && e.boundingClientRect.bottom < 0;
        update();
      },
      { threshold: 0 },
    ).observe(hero);
    new IntersectionObserver(
      ([e]) => {
        onFinal = e.isIntersecting;
        update();
      },
      { threshold: 0.1 },
    ).observe(final);
  }
</script>
