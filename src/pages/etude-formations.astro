  .station__label { font-family: var(--display); font-weight: 600; font-size: 14px; fill: var(--ink); text-anchor: middle; }
  .station__price { font-family: var(--hand); font-size: 17px; fill: var(--c); text-anchor: middle; }
  .station:hover circle:first-child, .station:focus-visible circle:first-child { fill: var(--c); }
  .ef:has(#start-1:checked) .station:not([data-rung='1']),
  .ef:has(#start-2:checked) .station:not([data-rung='2']),
  .ef:has(#start-3:checked) .station:not([data-rung='3']) { opacity: 0.45; }
  .metro__transfer { fill: none; stroke-width: 4; stroke-dasharray: 6 5; opacity: 0.8; }
  .metro__legend text { font-size: 13px; fill: var(--ink-2); }
  .legend__pack { fill: none; stroke: var(--ink-2); stroke-width: 2; stroke-dasharray: 3 3; }

  /* fiche de détail (A et D) */
  .detail { margin-top: var(--space-4); padding: var(--space-5) var(--space-6); border-radius: var(--radius-lg); background: var(--card); border: 1px solid var(--line); border-left: 5px solid var(--stage); display: grid; gap: var(--space-2); }
  .detail[hidden] { display: none; }
  .detail :global(h3) { margin: 0; font-size: var(--text-xl); }
  .detail :global(p) { margin: 0; color: var(--ink-2); }
  .detail :global(ul) { margin: 0; padding-left: 18px; color: var(--ink-2); font-size: var(--text-sm); }
  .detail :global(.detail__price) { font-family: var(--display); font-size: var(--text-2xl); font-weight: 700; color: var(--ink); }
  .detail :global(.detail__row) { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  .detail :global(.btn) { display: inline-flex; padding: var(--space-3) var(--space-5); border-radius: var(--radius-md); background: var(--stage); color: var(--xp-label); font-family: var(--display); font-weight: 600; text-decoration: none; }
  .detail :global(.chip) { display: inline-block; padding: 2px 10px; border-radius: 3px; background: var(--tint); color: var(--stage); font-family: var(--hand); font-size: 1.3rem; line-height: 1.1; }
  .detail :global(.hand-inline) { font-family: var(--hand); font-size: 1.6rem; color: var(--stage); }

  /* ---------- B · tableau ---------- */
  .table-wrap { overflow-x: auto; }
  .tbl { width: 100%; min-width: 760px; border-collapse: collapse; font-size: var(--text-sm); }
  .tbl thead th { text-align: left; padding: 8px 12px; font-family: var(--display); font-weight: 600; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); border-bottom: 2px solid var(--ink); }
  .tbl__group th { text-align: left; padding: 14px 12px 6px; font-family: var(--display); font-weight: 700; font-size: var(--text-base); color: var(--c); border-bottom: 2px solid var(--c); }
  .tbl td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tbl__course a { font-family: var(--display); font-weight: 600; text-decoration: none; }
  .tbl__course small { display: block; color: var(--ink-2); font-size: var(--text-xs); margin-top: 2px; max-width: 34ch; }
  .tbl__price { font-family: var(--display); font-weight: 700; font-size: var(--text-base); white-space: nowrap; }
  .tbl tbody { transition: opacity 0.25s; }
  .ef:has(#pick-guitar:checked) .tbl tbody:not([data-theme='guitar']),
  .ef:has(#pick-piano:checked) .tbl tbody:not([data-theme='piano']),
  .ef:has(#pick-ukulele:checked) .tbl tbody:not([data-theme='ukulele']),
  .ef:has(#pick-solfege:checked) .tbl tbody:not([data-theme='solfege']) { opacity: 0.5; }
  .ef:has(#start-1:checked) .tbl tr[data-rung]:not([data-rung='1']),
  .ef:has(#start-2:checked) .tbl tr[data-rung]:not([data-rung='2']),
  .ef:has(#start-3:checked) .tbl tr[data-rung]:not([data-rung='3']) { color: var(--ink-2); }
  .ef:has(#start-1:checked) .tbl tr[data-rung='1'],
  .ef:has(#start-2:checked) .tbl tr[data-rung='2'],
  .ef:has(#start-3:checked) .tbl tr[data-rung='3'] { background: var(--tint); }

  /* ---------- C · conseiller ---------- */
  .advice__grid { display: grid; gap: var(--space-6); align-items: start; }
  .advice__main { display: grid; gap: var(--space-2); padding: var(--space-6); border-radius: var(--radius-xl); background: var(--card); border: 1px solid var(--line); border-top: 5px solid var(--stage); }
  .advice__main .chip { justify-self: start; }
  .advice__main h3 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .advice__who { margin: 0; color: var(--ink-2); line-height: 1.5; }
  .advice__learn-title { margin: var(--space-2) 0 0; font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); }
  .advice__main ul { margin: 0; padding-left: 18px; color: var(--ink-2); }
  .advice__meta { margin: 0; font-size: var(--text-sm); color: var(--ink-2); }
  .advice__price { margin: var(--space-2) 0; display: flex; align-items: baseline; }
  .advice__price strong { font-family: var(--display); font-size: 2.4rem; }
  .advice__main .btn { justify-self: start; }
  .advice__side { display: grid; gap: var(--space-3); align-content: start; }
  .advice__next { display: grid; gap: 4px; padding: var(--space-4); border-radius: var(--radius-lg); background: var(--card); border: 1px solid var(--line); text-decoration: none !important; }
  .advice__next .chip { justify-self: start; }
  .advice__next-title { font-family: var(--display); font-weight: 700; }
  .advice__next-meta { font-size: var(--text-sm); color: var(--ink-2); }
  .advice__rest summary { cursor: pointer; font-family: var(--display); font-weight: 600; }
  .advice__rest ul { margin: var(--space-2) 0 0; padding-left: 18px; font-size: var(--text-sm); color: var(--ink-2); display: grid; gap: 4px; }

  /* ---------- D · grille ---------- */
  .grid-wrap { overflow-x: auto; }
  .school { display: grid; grid-template-columns: 150px repeat(3, 1fr); min-width: 820px; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); }
  .school__corner, .school__col, .school__row, .school__cell { padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); }
  .school__col { font-family: var(--display); font-weight: 700; text-align: center; background: var(--paper); }
  .school__row { font-family: var(--display); font-weight: 700; color: var(--c); display: grid; align-content: center; }
  .school__row small { font-family: var(--xp-text); font-weight: 400; font-size: var(--text-xs); color: var(--ink-2); }
  .school__cell { display: flex; flex-wrap: wrap; gap: 6px; align-content: flex-start; min-height: 64px; }
  .ef:has(#start-1:checked) [data-col='1'], .ef:has(#start-2:checked) [data-col='2'], .ef:has(#start-3:checked) [data-col='3'] { background: var(--tint); }
  .ef:has(#pick-guitar:checked) [data-theme='guitar'], .ef:has(#pick-piano:checked) [data-theme='piano'],
  .ef:has(#pick-ukulele:checked) [data-theme='ukulele'], .ef:has(#pick-solfege:checked) [data-theme='solfege'] { box-shadow: inset 4px 0 0 var(--c); }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border-radius: var(--radius-full); border: 1.5px solid var(--c); background: var(--card); color: var(--ink); font-family: var(--display); font-weight: 600; font-size: var(--text-sm); cursor: pointer; }
  .pill b { color: var(--c); }
  .pill i { font-style: normal; color: var(--c); }
  .pill:hover { background: var(--c); color: #fff; }
  .pill:hover b, .pill:hover i { color: #fff; }

  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 6fr 5fr; gap: var(--space-12); }
    .advice__grid { grid-template-columns: 1.3fr 1fr; }
  }
</style>

<script>
  /* Le hero, proposition : ses tuiles pilotent le même choix d'instrument. */
  document.querySelectorAll<HTMLInputElement>('input[name="instrument-hero"]').forEach((t) =>
    t.addEventListener('change', () => {
      const real = document.getElementById(`pick-${t.value}`) as HTMLInputElement | null;
      if (real) real.checked = true;
    }),
  );
  document.querySelectorAll<HTMLInputElement>('input[name="instrument"]').forEach((r) =>
    r.addEventListener('change', () => {
      const mirror = document.querySelector<HTMLInputElement>(`input[name="instrument-hero"][value="${r.value}"]`);
      if (mirror) mirror.checked = true;
    }),
  );

  /* A et D : la fiche de détail d'une station ou d'une pastille. */
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  document.querySelectorAll<HTMLElement>('[data-course]').forEach((el) => {
    const show = () => {
      const panel = el.closest('section')?.querySelector<HTMLElement>('[data-detail]');
      if (!panel) return;
      const d = el.dataset;
      panel.innerHTML = `
        <div class="detail__row"><span class="chip">${esc(d.level ?? '')}</span><h3>${esc(d.title ?? '')}</h3></div>
        <p>${esc(d.who ?? '')}</p>
        <p><strong>Vous apprenez :</strong></p>
        <ul>${(d.learn ?? '').split('|').filter(Boolean).map((l) => `<li>${esc(l)}</li>`).join('')}</ul>
        <p>${esc(d.meta ?? '')}</p>
        <div class="detail__row"><span class="detail__price">${esc(d.price ?? '')}</span>${d.pack ? `<span class="hand-inline">dans le ${esc(d.pack)}</span>` : ''}<a class="btn btn--stage" href="${d.url}">Voir le cours</a></div>`;
      panel.hidden = false;
      panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    el.addEventListener('click', show);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        show();
      }
    });
  });
</script>
