  .carnet3__feuille--1 { transform: rotate(1.2deg) translate(6px, 6px); }
  .carnet3__feuille--2 { transform: rotate(2.4deg) translate(12px, 12px); opacity: 0.75; }
  .carnet3__feuille--3 { transform: rotate(3.6deg) translate(18px, 18px); opacity: 0.5; }

  .carnet3:hover .carnet3__feuille--1 { transform: rotate(2deg) translate(10px, 10px); }
  .carnet3:hover .carnet3__feuille--2 { transform: rotate(4deg) translate(20px, 20px); }
  .carnet3:hover .carnet3__feuille--3 { transform: rotate(6deg) translate(30px, 30px); }

  .carnet3__page {
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
