  @media (prefers-reduced-motion: reduce) {
    .note,
    .note span,
    .btn,
    .playhead {
      transition: none;
    }
  }
</style>

<script>
  import { pluck, key, audio } from '../components/home/synth';

  const root = document.querySelector<HTMLElement>('.pr')!;
  const notes = [...root.querySelectorAll<HTMLButtonElement>('[data-note]')];
  const counter = root.querySelector<HTMLElement>('[data-count]')!;
  const playhead = root.querySelector<HTMLElement>('[data-playhead]')!;
  const roll = root.querySelector<HTMLElement>('[data-roll]')!;
  const instrument = () => document.querySelector<HTMLInputElement>('input[name="instrument"]:checked')?.value ?? 'guitar';
  const seen = new Set<Element>();
  /* Ce que le visiteur a réellement joué, avec ses temps : sa version. */
  const played: { el: HTMLElement; t: number }[] = [];
  const replay = root.querySelector<HTMLElement>('[data-replay]')!;
  const strip = root.querySelector<HTMLElement>('[data-strip]')!;

  const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  soundBtn?.addEventListener('click', () => {
    const on = soundBtn.getAttribute('aria-pressed') === 'true';
    soundBtn.setAttribute('aria-pressed', String(!on));
    soundBtn.textContent = on ? 'Son coupé' : 'Son activé';
    document.documentElement.dataset.sound = on ? 'off' : 'on';
    if (!on) audio();
  });
  // Le premier geste sur la page débloque l'audio (règle des navigateurs).
  const unlock = () => {
    audio();
    window.removeEventListener('pointerdown', unlock);
    window.removeEventListener('keydown', unlock);
  };
  window.addEventListener('pointerdown', unlock);
  window.addEventListener('keydown', unlock);

  const sound = (el: HTMLElement) => {
    const f = Number(el.dataset.freq);
    const dur = Number(getComputedStyle(el).getPropertyValue('--dur')) || 1;
    if (instrument() === 'guitar' || instrument() === 'ukulele') pluck(instrument() === 'ukulele' ? f * 2 : f, 0, 0.5);
    else key(f, 0, 0.9 + dur * 0.5, 0.4);
  };

  const hit = (el: HTMLElement) => {
    el.classList.remove('is-hit');
    void el.offsetWidth;
    el.classList.add('is-hit');
    el.classList.add('is-seen');
    window.setTimeout(() => el.classList.remove('is-hit'), 450);
    sound(el);
    played.push({ el, t: performance.now() });
    if (played.length >= 8) replay.hidden = false;
    if (!seen.has(el)) {
      seen.add(el);
      counter.textContent = String(seen.size);
    }
  };

  /* Une bande fine autour de la ligne « maintenant » : la note qui y entre sonne. */
  if ('IntersectionObserver' in window) {
    const band = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && hit(e.target as HTMLElement)),
      { rootMargin: '-60% 0px -35% 0px', threshold: 0 },
    );
    notes.forEach((n) => band.observe(n));
    new IntersectionObserver(([e]) => playhead.classList.toggle('is-on', e.isIntersecting), { rootMargin: '-40% 0px -30% 0px' }).observe(roll);
  }

  // Réécouter sa version : les mêmes notes, avec les mêmes silences (plafonnés à 1,4 s).
  root.querySelector<HTMLButtonElement>('[data-replay-btn]')?.addEventListener('click', () => {
    audio();
    strip.innerHTML = played.map(() => '<i></i>').join('');
    const dots = [...strip.children] as HTMLElement[];
    let at = 0;
    played.forEach((p, i) => {
      if (i > 0) at += Math.min(1400, Math.max(120, p.t - played[i - 1].t));
      window.setTimeout(() => {
        sound(p.el);
        dots[i].classList.add('is-on');
        window.setTimeout(() => dots[i].classList.remove('is-on'), 260);
      }, at);
    });
  });

  // On peut aussi cliquer une note, pour l'entendre encore.
  notes.forEach((n) => n.addEventListener('click', () => hit(n)));
</script>
